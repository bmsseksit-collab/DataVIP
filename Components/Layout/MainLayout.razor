@inherits LayoutComponentBase
@inject NavigationManager Nav

<div class="main-layout">

    <div class="sidebar @(isSidebarCollapsed ? "collapsed" : "")">

        <button class="toggle-sidebar-btn"
                @onclick="ToggleSidebar">
            ☰
        </button>

        <div class="logo">
            <h2>DataVIP</h2>
        </div>

        <div class="menu">

            <a class="menu-item"
               @onclick='() => Nav.NavigateTo("/employees")'>
                <span class="menu-icon">👥</span>
                <span>รายชื่อพนักงาน</span>
            </a>

            <div class="bank-menu-group">

                <button class="menu-item bank-menu-title"
                        @onclick="ToggleBankMenu">
                    <span class="menu-icon">🏦</span>
                    <span>บัญชีธนาคาร</span>
                    <span class="bank-arrow @(isBankMenuOpen ? "open" : "")">▾</span>
                </button>

                @if (isBankMenuOpen && !isSidebarCollapsed)
                {
                    <div class="bank-sub-menu">
                        <a class="sub-menu-item" @onclick='() => Nav.NavigateTo("/banks")'>
                            รายการบัญชี
                        </a>

                        <a class="sub-menu-item" @onclick='() => Nav.NavigateTo("/bank-status")'>
                            สถานะบัญชี
                        </a>

                        <a class="sub-menu-item" @onclick='() => Nav.NavigateTo("/bank-new-this-month")'>
                            บัญชีใหม่เดือนนี้
                        </a>

                        <a class="sub-menu-item" @onclick='() => Nav.NavigateTo("/bank-summary")'>
                            สรุปบัญชีทุกประเภท
                        </a>
                    </div>
                }

            </div>
        
            @if (AuthState.Role == "owner")
            {
                <a class="menu-item"
                   @onclick='() => Nav.NavigateTo("/users")'>
                    <span class="menu-icon">🔐</span>
                    <span>จัดการสิทธิ์</span>
                </a>
            }

        </div>

        <div class="bottom-menu">

            <div class="admin-box">
                <b>@AuthState.Username</b>
                <p>@AuthState.Role</p>
            </div>

            <button class="logout-btn"
                    @onclick="Logout">
                ออกจากระบบ
            </button>

        </div>

    </div>

    <div class="content">
        @Body
    </div>

</div>

@code {
    private bool isSidebarCollapsed = false;
    private bool isBankMenuOpen = false;

    protected override void OnInitialized()
    {
        CheckSessionExpired();
    }

    private void CheckSessionExpired()
    {
        if (!AuthState.IsLoggedIn)
            return;

        if (AuthState.LoginAt == null)
        {
            Logout();
            return;
        }

        if (DateTime.Now - AuthState.LoginAt.Value >= TimeSpan.FromHours(24))
        {
            Logout();
        }
    }

    private void ToggleBankMenu()
    {
        isBankMenuOpen = !isBankMenuOpen;
    }

    private void ToggleSidebar()
    {
        isSidebarCollapsed = !isSidebarCollapsed;
    }

    private void Logout()
    {
        AuthState.IsLoggedIn = false;
        AuthState.Username = "";
        AuthState.Role = "";
        AuthState.LoginAt = null;

        Nav.NavigateTo("/");
    }
}

