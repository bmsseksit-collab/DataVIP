@inherits LayoutComponentBase
@inject NavigationManager Nav

<div class="main-layout">

    <div class="sidebar @(isSidebarCollapsed ? "collapsed" : "")">

        <button class="toggle-sidebar-btn"
                @onclick="ToggleSidebar">
            ☰
        </button>

        <div class="logo">
            <h2>DataVIP</h2>
        </div>

        <div class="menu">

            <a class="menu-item"
               @onclick='() => Nav.NavigateTo("/employees")'>
                <span class="menu-icon">👥</span>
                <span>รายชื่อพนักงาน</span>
            </a>

            <a class="menu-item">
                <span class="menu-icon">🏦</span>
                <span>บัญชีธนาคาร</span>
            </a>

            @if (AuthState.Role == "owner")
            {
                <a class="menu-item"
                   @onclick='() => Nav.NavigateTo("/users")'>
                    <span class="menu-icon">🔐</span>
                    <span>จัดการสิทธิ์</span>
                </a>
            }

        </div>

        <div class="bottom-menu">

            <div class="admin-box">
                <b>@AuthState.Username</b>
                <p>@AuthState.Role</p>
            </div>

            <button class="logout-btn"
                    @onclick="Logout">
                ออกจากระบบ
            </button>

        </div>

    </div>

    <div class="content">
        @Body
    </div>

</div>

@code {
    private bool isSidebarCollapsed = false;

    private void ToggleSidebar()
    {
        isSidebarCollapsed = !isSidebarCollapsed;
    }

    private void Logout()
    {
        AuthState.IsLoggedIn = false;
        AuthState.Username = "";
        AuthState.Role = "";

        Nav.NavigateTo("/");
    }
}

<style>
    .main-layout {
        display: flex;
        min-height: 100vh;
    }

    .sidebar {
        position: relative;
        overflow: hidden;
        width: 250px;
        min-width: 250px;
        min-height: 100vh;
        background: linear-gradient(180deg, #09001f, #210044, #3b006b);
        background-size: 200% 200%;
        animation: sidebarGradient 10s ease infinite;
        border-right: 1px solid rgba(255,255,255,.08);
        padding: 24px 18px;
        box-sizing: border-box;
        color: white;
        display: flex;
        flex-direction: column;
        box-shadow: 8px 0 30px rgba(0,0,0,.18);
        transition: all .35s ease;
    }

    @@keyframes sidebarGradient {
        0% {
            background-position: 0% 0%;
        }

        50% {
            background-position: 0% 100%;
        }

        100% {
            background-position: 0% 0%;
        }
    }

    .sidebar::after {
        content: "";
        position: absolute;
        top: -120px;
        right: -120px;
        width: 260px;
        height: 260px;
        background: rgba(168,85,247,.18);
        border-radius: 50%;
        filter: blur(60px);
        pointer-events: none;
    }

    .toggle-sidebar-btn {
        position: absolute;
        top: 18px;
        right: 10px;
        width: 34px;
        height: 34px;
        border: none;
        border-radius: 10px;
        background: #ffffff;
        color: #6d28ff;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 18px rgba(0,0,0,0.15);
        transition: all .25s ease;
        z-index: 100;
    }

        .toggle-sidebar-btn:hover {
            transform: scale(1.06);
            background: #f4edff;
        }

    .logo h2 {
        margin: 0 0 35px 0;
        font-size: 26px;
        font-weight: 800;
        background: linear-gradient(90deg,#ffffff,#d8b4fe,#ffffff);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: logoGlow 5s linear infinite;
    }

    @@keyframes logoGlow {
        0% {
            background-position: 0% center;
        }

        100% {
            background-position: 200% center;
        }
    }

    .menu {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .menu-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 18px;
        border-radius: 16px;
        color: white;
        text-decoration: none;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: .25s;
        position: relative;
        overflow: hidden;
    }

        .menu-item:hover {
            background: rgba(255,255,255,.10);
            transform: translateX(6px) scale(1.02);
            box-shadow: 0 8px 20px rgba(124,58,237,.25);
        }

        .menu-item::before {
            content: "";
            position: absolute;
            top: 0;
            left: -120%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.12), transparent);
            transition: .6s;
        }

        .menu-item:hover::before {
            left: 120%;
        }

    .bottom-menu {
        margin-top: auto;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .admin-box {
        background: rgba(255,255,255,.08);
        padding: 16px;
        border-radius: 16px;
    }

        .admin-box p {
            margin: 5px 0 0;
            color: #ddd6fe;
        }

    .logout-btn {
        border: none;
        background: rgba(255,255,255,.08);
        color: white;
        padding: 14px;
        border-radius: 14px;
        font-weight: 700;
        cursor: pointer;
    }

    .content {
        flex: 1;
        padding: 28px 34px;
        transition: all .35s ease;
        animation: pageFade .45s ease;
    }

    @@keyframes pageFade {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .sidebar.collapsed {
        width: 90px;
        min-width: 90px;
        padding: 24px 12px;
    }

        .sidebar.collapsed .logo h2,
        .sidebar.collapsed .menu-item span:last-child,
        .sidebar.collapsed .admin-box,
        .sidebar.collapsed .logout-btn {
            opacity: 0;
            visibility: hidden;
            width: 0;
            height: 0;
            overflow: hidden;
        }

        .sidebar.collapsed .menu-item {
            justify-content: center;
            padding: 16px 0;
        }

        .sidebar.collapsed .menu-icon {
            margin-right: 0;
            font-size: 22px;
        }

    @@media (max-width: 900px) {
        .main-layout {
            flex-direction: column;
        }

        .sidebar {
            width: 100%;
            min-width: 100%;
            min-height: auto;
            border-radius: 0 0 24px 24px;
        }

        .content {
            padding: 18px;
        }
    }
</style>