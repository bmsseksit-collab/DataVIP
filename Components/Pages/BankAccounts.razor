@page "/banks"
@using DataVipWeb.Models
@using DataVipWeb.Services

@inject SupabaseService SupabaseService
@inject NavigationManager Nav

<div class="bank-page">

    <div class="bank-header">
        <div>
            <h1 class="page-title">บัญชีธนาคาร</h1>
            <p class="page-subtitle">ระบบจัดการบัญชีธนาคารและกลุ่มบัญชี</p>
        </div>

        <div class="header-actions">
            <input class="search-box"
                   placeholder="ค้นหาบัญชี..."
                   @bind="searchText"
                   @bind:event="oninput" />

            <select class="group-filter" @bind="selectedGroup">
                <option value="">ทุกกลุ่มบัญชี</option>
                @foreach (var group in Groups)
                {
                    <option value="@group">@group</option>
                }
            </select>

            <button class="add-btn" @onclick="OpenAddModal">
                + เพิ่มบัญชี
            </button>
        </div>
    </div>

    <div class="summary-cards">

        <div class="summary-card purple-card">
            <div class="summary-icon">💼</div>
            <div>
                <p>บัญชีทั้งหมด</p>
                <h1>@bankAccounts.Count</h1>
                <span>บัญชี</span>
            </div>
        </div>

        <div class="summary-card blue-card">
            <div class="summary-icon">👥</div>
            <div>
                <p>จำนวนกลุ่มบัญชี</p>
                <h1>@Groups.Count</h1>
                <span>กลุ่ม</span>
            </div>
        </div>

        <div class="summary-card orange-card">
            <div class="summary-icon">📈</div>
            <div>
                <p>เพิ่มใหม่เดือนนี้</p>
                <h1>0</h1>
                <span>บัญชี</span>
            </div>
        </div>

        <div class="summary-card green-card">
            <div class="summary-icon">🔍</div>
            <div>
                <p>ผลการค้นหา</p>
                <h1>@FilteredAccounts.Count()</h1>
                <span>รายการ</span>
            </div>
        </div>

    </div>

    <div class="group-box">

        <h2>กลุ่มบัญชีทั้งหมด</h2>

        <div class="group-cards">

            @foreach (var group in Groups)
            {
                <div class="group-card @(selectedGroup == group ? "active" : "")"
                     @onclick="() => selectedGroup = group">

                    <div class="group-icon">🏦</div>

                    <div>
                        <b>@group</b>
                        <h1>@bankAccounts.Count(x => x.GroupName == group)</h1>
                        <p>บัญชี</p>
                    </div>

                </div>
            }

            <div class="group-card add-group-card">
                <div class="plus-icon">+</div>
                <b>เพิ่มสายบัญชี</b>
            </div>

        </div>
    </div>

    <div class="table-box">

        <h2>รายการบัญชีธนาคาร</h2>

        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th>สายบัญชี</th>
                        <th>ธนาคาร</th>
                        <th>ชื่อบัญชี</th>
                        <th>เลขที่บัญชี</th>
                        <th>วันที่รับบัญชี</th>
                        <th>รายละเอียด</th>
                        <th>จัดการ</th>
                    </tr>
                </thead>

                <tbody>

                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="7">
                                กำลังโหลดข้อมูล...
                            </td>
                        </tr>
                    }
                    else if (!string.IsNullOrWhiteSpace(loadError))
                    {
                        <tr>
                            <td colspan="7">
                                Error: @loadError
                            </td>
                        </tr>
                    }
                    else if (!FilteredAccounts.Any())
                    {
                        <tr>
                            <td colspan="7">
                                ยังไม่มีข้อมูลบัญชี
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in FilteredAccounts)
                        {
                            <tr>

                                <td>
                                    <span class="dot"></span>
                                    @item.GroupName
                                </td>

                                <td>
                                    <div class="bank-name">
                                        <span class="bank-logo">🏦</span>
                                        @item.BankName
                                    </div>
                                </td>

                                <td>@item.AccountName</td>

                                <td>@item.AccountNumber</td>

                                <td>-</td>

                                <td>
                                    <button class="detail-btn"
                                            @onclick="() => OpenDetail(item)">
                                        ดูรายละเอียด
                                    </button>
                                </td>

                                <td>
                                    <button class="icon-btn edit">
                                        ✎
                                    </button>

                                    <button class="icon-btn delete">
                                        🗑
                                    </button>
                                </td>

                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>

        <div class="footer-note">
            แสดง @FilteredAccounts.Count() รายการ จาก @bankAccounts.Count รายการ
        </div>

    </div>

</div>

@if (selectedAccount != null)
{
    <div class="detail-panel">

        <div class="detail-header">
            <h2>รายละเอียดบัญชี</h2>
            <button @onclick="CloseDetail">×</button>
        </div>

        <div class="bank-logo-big">🏦</div>

        <h3>@selectedAccount.BankName</h3>
        <p>สายบัญชี: <b>@selectedAccount.GroupName</b></p>

        <div class="detail-list">
            <p><span>ชื่อบัญชี</span> <b>@selectedAccount.AccountName</b></p>
            <p><span>เลขที่บัญชี</span> <b>@selectedAccount.AccountNumber</b></p>
            <p><span>ประเภทบัญชี</span> <b>@selectedAccount.AccountType</b></p>
            <p><span>สาขา</span> <b>@selectedAccount.Branch</b></p>
            <p><span>หมายเหตุ</span> <b>@selectedAccount.Note</b></p>
            <p><span>วันที่เพิ่ม</span> <b>-</b></p>
        </div>

        <button class="close-detail-btn" @onclick="CloseDetail">
            ปิด
        </button>

    </div>
}
@if (showAddModal)
{
    <div class="modal-overlay">
        <div class="modal-box large-modal">

            <div class="modal-header">
                <h2>เพิ่มบัญชีธนาคาร</h2>
                <button class="modal-close" @onclick="CloseAddModal">×</button>
            </div>

            <div class="modal-grid">

                <input placeholder="สายบัญชี เช่น สาย 1"
                       @bind="newAccount.GroupName" />

                <select @bind="newAccount.AccountType">
                    <option>SCB บุคคล</option>
                    <option>SCB นิติ</option>
                    <option>KTB บุคคล</option>
                    <option>KTB นิติ</option>
                </select>

                <input placeholder="ธนาคาร"
                       @bind="newAccount.BankName" />

                <input placeholder="ชื่อบัญชี"
                       @bind="newAccount.AccountName" />

                <input placeholder="ชื่อเจ้าของบัญชี"
                       @bind="newAccount.OwnerName" />

                <input placeholder="เลขที่บัญชี"
                       @bind="newAccount.AccountNumber" />

                <input placeholder="สาขา"
                       @bind="newAccount.Branch" />

                <input placeholder="หมายเหตุ"
                       @bind="newAccount.Note" />

            </div>

            <div class="modal-actions">
                <button class="cancel-btn" @onclick="CloseAddModal">
                    ยกเลิก
                </button>

                <button class="save-btn"
                        disabled="@isSaving"
                        @onclick="SaveAccount">
                    @(isSaving ? "กำลังบันทึก..." : "บันทึก")
                </button>
            </div>

        </div>
    </div>
}
@if (!string.IsNullOrWhiteSpace(warningMessage))
{
    <div class="warning-toast">
        @warningMessage
    </div>
}

@code {
    private string searchText = "";
    private string selectedGroup = "";
    private BankAccount? selectedAccount;

    private List<BankAccount> bankAccounts = new();
    private bool isLoading = true;
    private string loadError = "";

    private bool showAddModal = false;
    private bool isSaving = false;
    private string warningMessage = "";

    private BankAccount newAccount = new();

    private void OpenAddModal()
    {
        newAccount = new BankAccount
        {
            GroupName = "",
            BankName = "SCB",
            AccountType = "SCB บุคคล"
        };

        showAddModal = true;
    }

    private void CloseAddModal()
    {
        showAddModal = false;
    }

    private List<string> Groups =>
        bankAccounts
            .Select(x => x.GroupName)
            .Distinct()
            .OrderBy(x => x)
            .ToList();

    private IEnumerable<BankAccount> FilteredAccounts =>
        bankAccounts.Where(x =>
            (string.IsNullOrWhiteSpace(selectedGroup) || x.GroupName == selectedGroup) &&
            (string.IsNullOrWhiteSpace(searchText) ||
             x.GroupName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             x.BankName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             x.AccountName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             x.AccountNumber.Contains(searchText, StringComparison.OrdinalIgnoreCase)));

    private void OpenDetail(BankAccount account)
    {
        selectedAccount = account;
    }

    private void CloseDetail()
    {
        selectedAccount = null;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsLoggedIn)
        {
            Nav.NavigateTo("/");
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            loadError = "";

            var result = await SupabaseService.Client
                .From<BankAccount>()
                .Get();

            bankAccounts = result.Models ?? new List<BankAccount>();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAccount()
    {
    if (isSaving)
        return;

    if (string.IsNullOrWhiteSpace(newAccount.GroupName) ||
        string.IsNullOrWhiteSpace(newAccount.BankName) ||
        string.IsNullOrWhiteSpace(newAccount.AccountType) ||
        string.IsNullOrWhiteSpace(newAccount.AccountName) ||
        string.IsNullOrWhiteSpace(newAccount.AccountNumber))
    {
        warningMessage = "กรุณากรอกข้อมูลให้ครบ";
        return;
    }

    isSaving = true;

    try
    {
        await SupabaseService.Client
            .From<BankAccount>()
            .Insert(newAccount);

        await LoadData();

        showAddModal = false;
        newAccount = new BankAccount();
    }
    finally
    {
        isSaving = false;
    }
    }
    
    private string FormatThaiDate(DateTime date)
    {
        string[] months =
        {
            "ม.ค.", "ก.พ.", "มี.ค.", "เม.ย.",
            "พ.ค.", "มิ.ย.", "ก.ค.", "ส.ค.",
            "ก.ย.", "ต.ค.", "พ.ย.", "ธ.ค."
        };

        return $"{date.Day} {months[date.Month - 1]} {date.Year + 543}";
    }

    
}
