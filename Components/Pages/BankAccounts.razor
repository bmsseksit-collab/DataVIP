@page "/banks"
@using DataVipWeb.Components.Pages.BankForms
@using DataVipWeb.Models
@using DataVipWeb.Services
@using System.Text.Json

@inject SupabaseService SupabaseService
@inject NavigationManager Nav

<div class="bank-page">

    <div class="bank-header">
        <div>
            <h1 class="page-title">บัญชีธนาคาร</h1>
            <p class="page-subtitle">ระบบจัดการบัญชีธนาคารและกลุ่มบัญชี</p>
        </div>

        <div class="header-actions">
            <input class="search-box"
                   placeholder="ค้นหาบัญชี..."
                   @bind="searchText"
                   @bind:event="oninput" />

            <button class="add-btn" @onclick="OpenAddModal">
                + เพิ่มบัญชี
            </button>
        </div>
    </div>

    <div class="summary-cards">

        <div class="summary-card purple-card">
            <div class="summary-icon">💼</div>
            <div>
                <p>บัญชีทั้งหมด</p>
                <h1>@bankAccounts.Count</h1>
                <span>บัญชี</span>
            </div>
        </div>

        <div class="summary-card blue-card">
            <div class="summary-icon">👥</div>
            <div>
                <p>จำนวนกลุ่มบัญชี</p>
                <h1>@Groups.Count</h1>
                <span>กลุ่ม</span>
            </div>
        </div>

        <div class="summary-card orange-card">
            <div class="summary-icon">📈</div>
            <div>
                <p>เพิ่มใหม่เดือนนี้</p>
                <h1>0</h1>
                <span>บัญชี</span>
            </div>
        </div>

        <div class="summary-card green-card">
            <div class="summary-icon">🔍</div>
            <div>
                <p>ผลการค้นหา</p>
                <h1>@FilteredAccounts.Count()</h1>
                <span>รายการ</span>
            </div>
        </div>

    </div>

    <div class="group-box">

        <h2>กลุ่มบัญชีทั้งหมด</h2>

        <div class="group-cards">

            <div class="group-card @(string.IsNullOrWhiteSpace(selectedGroup) ? "active" : "")"
                 @onclick="() => selectedGroup = string.Empty">

                <div class="group-icon">📋</div>

                <div>
                    <b>บัญชีทั้งหมด</b>
                    <h1>@bankAccounts.Count</h1>
                    <p>บัญชี</p>
                </div>

            </div>

            @foreach (var group in Groups)
            {
                <div class="group-card @(selectedGroup == group ? "active" : "")"
                     @onclick="() => selectedGroup = group">

                    <button class="delete-group-btn"
                            @onclick:stopPropagation="true"
                            @onclick="() => ConfirmDeleteGroup(group)"
                            title="ลบสายบัญชี">
                        🗑
                    </button>

                    <button class="edit-group-btn"
                            @onclick:stopPropagation="true"
                            @onclick="() => OpenEditGroupModal(group)">
                        ✎
                    </button>

                    <div class="group-icon">🏦</div>

                    <div>
                        <b>@group</b>
                        <h1>@bankAccounts.Count(x => x.GroupName == group)</h1>
                        <p>บัญชี</p>
                    </div>

                </div>
            }

            <div class="group-card add-group-card"
                 @onclick="OpenAddGroupModal">
                <div class="plus-icon">+</div>
                <b>เพิ่มสายบัญชี</b>
            </div>

        </div>
    </div>

    <div class="table-box">

        <h2>รายการบัญชีธนาคาร</h2>

        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th>สายบัญชี</th>
                        <th>ธนาคาร</th>
                        <th>ชื่อบัญชี</th>
                        <th>เลขที่บัญชี</th>
                        <th>วันที่รับบัญชี</th>
                        <th>สถานะ</th>
                        <th>รายละเอียด</th>
                        <th>จัดการ</th>
                    </tr>
                </thead>

                <tbody>

                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="8">
                                กำลังโหลดข้อมูล...
                            </td>
                        </tr>
                    }
                    else if (!string.IsNullOrWhiteSpace(loadError))
                    {
                        <tr>
                            <td colspan="8">
                                Error: @loadError
                            </td>
                        </tr>
                    }
                    else if (!FilteredAccounts.Any())
                    {
                        <tr>
                            <td colspan="8">
                                ยังไม่มีข้อมูลบัญชี
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in FilteredAccounts)
                        {
                            <tr>

                                <td>
                                    <span class="dot"></span>
                                    @item.GroupName
                                </td>

                                <td>
                                    <div class="bank-name">
                                        <span class="bank-logo">
                                            <img src="@BankDetailHelper.GetBankLogo(item.BankName)" />
                                        </span>
                                        @item.AccountType
                                    </div>
                                </td>

                                <td>@item.AccountName</td>

                                <td>@item.AccountNumber</td>

                                <td>@GetDetailDate(item, "ReceivedDate")</td>
                                <td>
                                    <span class="@GetStatusClass(item.Status)">
                                        @item.Status
                                    </span>
                                </td>

                                <td>
                                    <button class="detail-btn"
                                            @onclick="() => OpenDetail(item)">
                                        ดูรายละเอียด
                                    </button>
                                </td>

                                <td>
                                    <button class="icon-btn edit"
                                            @onclick="() => OpenEditModal(item)">
                                        ✎
                                    </button>

                                    <button class="icon-btn delete"
                                            @onclick="() => ConfirmDelete(item)">
                                        🗑
                                    </button>
                                </td>

                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>

        <div class="footer-note">
            แสดง @FilteredAccounts.Count() รายการ จาก @bankAccounts.Count รายการ
        </div>

    </div>

</div>

<BankDetailPanel Account="selectedAccount"
                 OnClose="CloseDetail" />

@if (showAddModal)
{
    <div class="modal-overlay">
        <div class="modal-box large-modal">

            <div class="modal-header">
                <h2>@(isEditMode ? "แก้ไขบัญชีธนาคาร" : "เพิ่มบัญชีธนาคาร")</h2>
                <button class="modal-close" @onclick="CloseAddModal">×</button>
            </div>

            <div class="modal-grid">

                <select @bind="newAccount.GroupName">
                    <option value="">เลือกสายบัญชี</option>

                    @foreach (var group in Groups)
                    {
                        <option value="@group">@group</option>
                    }
                </select>

                <select value="@newAccount.AccountType"
                        @onchange="OnAccountTypeChanged">

                    <option value="">เลือกประเภทบัญชี</option>

                    <option>SCB บุคคล</option>
                    <option>SCB นิติ</option>

                    <option>KBANK บุคคล</option>
                    <option>KBANK นิติ</option>

                    <option>GSB บุคคล</option>
                    <option>GSB นิติ</option>

                    <option>TTB นิติ</option>

                    <option>KTB บุคคล</option>
                    <option>KTB นิติ</option>

                    <option>BAY บุคคล</option>
                    <option>BAY นิติ</option>

                    <option>BBL บุคคล</option>

                    <option>BAAC บุคคล</option>

                    <option>KKP นิติ</option>

                </select>

                <select @bind="newAccount.Status">
                    <option>ใช้งานอยู่</option>
                    <option>พร้อมใช้งาน</option>
                    <option>มีปัญหา</option>
                </select>

                <input placeholder="หมายเหตุสถานะ"
                       @bind="newAccount.StatusNote" />

                @if (newAccount.AccountType == "SCB นิติ")
                {
                    <CorporateScbForm Account="newAccount"
                                      GetDetailValue="GetDetailValue"
                                      SetDetailValue="SetDetailValue" />
                }

                @if (IsDualApprovalBank(newAccount.AccountType))
                {
                    <DualApprovalForm Account="newAccount"
                                      AccountType="newAccount.AccountType"
                                      GetDetailValue="GetDetailValue"
                                      SetDetailValue="SetDetailValue" />
                }
                
                @if (IsPersonalBank(newAccount.AccountType))
                {
                    <PersonalBankForm Account="newAccount"
                                      GetDetailValue="GetDetailValue"
                                      SetDetailValue="SetDetailValue" />
                }

                @if (IsBizBank(newAccount.AccountType))
                {
                    <BizBankForm Account="newAccount"
                                 AccountType="@newAccount.AccountType"
                                 GetDetailValue="GetDetailValue"
                                 SetDetailValue="SetDetailValue" />
                }

            </div>

            <div class="modal-actions">
                <button class="cancel-btn" @onclick="CloseAddModal">
                    ยกเลิก
                </button>

                <button class="save-btn"
                        disabled="@isSaving"
                        @onclick="SaveAccount">
                    @(isSaving ? "กำลังบันทึก..." : isEditMode ? "บันทึกการแก้ไข" : "บันทึก")
                </button>
            </div>

        </div>
    </div>
}

@if (showAddGroupModal)
{
    <div class="modal-overlay">
        <div class="modal-box">

            <div class="modal-header">
                <h2>เพิ่มสายบัญชี</h2>
                <button class="modal-close" @onclick="CloseAddGroupModal">×</button>
            </div>

            <div class="modal-grid one-column">
                <input placeholder="เช่น สาย 1, สาย VIP, สาย SCB"
                       @bind="newGroupName" />
            </div>

            <div class="modal-actions">
                <button class="cancel-btn" @onclick="CloseAddGroupModal">
                    ยกเลิก
                </button>

                <button class="save-btn" @onclick="SaveGroupName">
                    บันทึกสายบัญชี
                </button>
            </div>

        </div>
    </div>
}
@if (!string.IsNullOrWhiteSpace(warningMessage))
{
    <div class="warning-toast">
        @warningMessage
    </div>
}
@if (showDeleteModal)
{
    <div class="modal-overlay">
        <div class="delete-modal">

            <h2>ยืนยันการลบ</h2>

            <p>
                ต้องการลบบัญชีนี้ใช่หรือไม่?
            </p>

            <div class="delete-actions">

                <button class="cancel-btn"
                        @onclick="CancelDelete">
                    ยกเลิก
                </button>

                <button class="confirm-delete-btn"
                        disabled="@isDeleting"
                        @onclick="DeleteConfirmed">
                    @(isDeleting ? "กำลังลบ..." : "ลบข้อมูล")
                </button>

            </div>

        </div>
    </div>
}
@if (showDeleteGroupModal)
{
    <div class="modal-overlay">
        <div class="delete-modal">

            <h2>ยืนยันการลบสายบัญชี</h2>

            <p>
                ต้องการลบสายบัญชี <b>@groupToDelete</b> ใช่หรือไม่?<br />
                บัญชีในสายนี้จะไม่ถูกลบ แต่จะกลายเป็นบัญชีที่ไม่มีสาย
            </p>

            <div class="delete-actions">

                <button class="cancel-btn"
                        @onclick="CancelDeleteGroup">
                    ยกเลิก
                </button>

                <button class="confirm-delete-btn"
                        disabled="@isDeletingGroup"
                        @onclick="DeleteGroupConfirmed">

                    @(isDeletingGroup ? "กำลังลบ..." : "ลบสายบัญชี")

                </button>

            </div>

        </div>
    </div>
}
@if (showEditGroupModal)
{
    <div class="modal-overlay">
        <div class="modal-box">

            <div class="modal-header">
                <h2>แก้ไขชื่อสายบัญชี</h2>
                <button class="modal-close" @onclick="CloseEditGroupModal">×</button>
            </div>

            <div class="modal-grid one-column">
                <input placeholder="ชื่อสายบัญชี"
                       @bind="editGroupName" />
            </div>

            <div class="modal-actions">
                <button class="cancel-btn" @onclick="CloseEditGroupModal">
                    ยกเลิก
                </button>

                <button class="save-btn"
                        disabled="@isSavingGroupEdit"
                        @onclick="SaveEditGroupName">
                    @(isSavingGroupEdit ? "กำลังบันทึก..." : "บันทึกการแก้ไข")
                </button>
            </div>

        </div>
    </div>
}

@code {
    private Dictionary<string, string> detailsFields = new();
    private bool showDeleteGroupModal = false;
    private bool isDeletingGroup = false;
    private bool showDeleteModal = false;
    private string groupToDelete = "";
    private bool isDeleting = false;
    private BankAccount? accountToDelete;
    private string searchText = "";
    private string selectedGroup = "";
    private BankAccount? selectedAccount;

    private List<BankAccount> bankAccounts = new();
    private bool isLoading = true;
    private string loadError = "";

    private bool showAddModal = false;
    private bool showAddGroupModal = false;
    private string newGroupName = "";
    private bool isSaving = false;
    private string warningMessage = "";
    private List<BankGroup> bankGroups = new();
    private bool isEditMode = false;
    private BankAccount? editingAccount;
    private BankAccount newAccount = new();
    private bool showEditGroupModal = false;
    private bool isSavingGroupEdit = false;
    private string oldGroupName = "";
    private string editGroupName = "";

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "ใช้งานอยู่" => "status-active",
            "พร้อมใช้งาน" => "status-ready",
            "มีปัญหา" => "status-problem",
            _ => "status-ready"
        };
    }

    private async Task SaveEditGroupName()
    {
        if (isSavingGroupEdit)
            return;

        if (string.IsNullOrWhiteSpace(editGroupName))
        {
            warningMessage = "กรุณากรอกชื่อสายบัญชี";
            return;
        }

        var newName = editGroupName.Trim();

        if (newName == oldGroupName)
        {
            CloseEditGroupModal();
            return;
        }

        if (Groups.Contains(newName))
        {
            warningMessage = "มีสายบัญชีนี้อยู่แล้ว";
            return;
        }

        isSavingGroupEdit = true;
        warningMessage = "";

        try
        {
            var group = bankGroups.FirstOrDefault(x => x.GroupName == oldGroupName);

            if (group != null)
            {
                group.GroupName = newName;

                await SupabaseService.Client
                    .From<BankGroup>()
                    .Update(group);
            }

            var accountsInGroup = bankAccounts
                .Where(x => x.GroupName == oldGroupName)
                .ToList();

            foreach (var account in accountsInGroup)
            {
                account.GroupName = newName;

                await SupabaseService.Client
                    .From<BankAccount>()
                    .Update(account);
            }

            if (selectedGroup == oldGroupName)
                selectedGroup = newName;

            CloseEditGroupModal();

            await LoadData();
        }
        catch (Exception ex)
        {
            warningMessage = "❌ " + ex.Message;
        }
        finally
        {
            isSavingGroupEdit = false;
        }
    }
    private void OpenEditGroupModal(string groupName)
    {
        oldGroupName = groupName;
        editGroupName = groupName;
        showEditGroupModal = true;
    }

    private void CloseEditGroupModal()
    {
        showEditGroupModal = false;
        oldGroupName = "";
        editGroupName = "";
    }
    private void OpenEditModal(BankAccount account)
    {
        warningMessage = "";
        isEditMode = true;
        editingAccount = account;

        newAccount = new BankAccount
        {
            Id = account.Id,
            GroupName = account.GroupName,
            BankName = account.BankName,
            AccountType = account.AccountType,
            AccountName = account.AccountName,
            OwnerName = account.OwnerName,
            AccountNumber = account.AccountNumber,
            Branch = account.Branch,
            Note = account.Note,
            Status = account.Status,
            StatusNote = account.StatusNote,
            DetailsJson = account.DetailsJson
        };

        try
        {
            detailsFields = JsonSerializer.Deserialize<Dictionary<string, string>>(account.DetailsJson)
                            ?? new Dictionary<string, string>();
        }
        catch
        {
            detailsFields = new Dictionary<string, string>();
        }

        showAddModal = true;
    }

    private string GetDetailDate(BankAccount account, string key)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(account.DetailsJson))
                return "-";

            var details = JsonSerializer.Deserialize<Dictionary<string, string>>(account.DetailsJson);

            if (details == null || !details.ContainsKey(key))
                return "-";

            var value = details[key];

            if (DateTime.TryParse(value, out var date))
                return FormatThaiDate(date);

            return string.IsNullOrWhiteSpace(value) ? "-" : value;
        }
        catch
        {
            return "-";
        }
    }

    private void OnAccountTypeChanged(ChangeEventArgs e)
    {
        newAccount.AccountType = e.Value?.ToString() ?? "";

        newAccount.AccountName = "";
        newAccount.OwnerName = "";
        newAccount.AccountNumber = "";
        newAccount.Branch = "";
        newAccount.Note = "";

        ResetFormByType();
    }

    private string GetDetailValue(string key)
    {
        return detailsFields.ContainsKey(key) ? detailsFields[key] : "";
    }

    private void SetDetailValue(string key, string value)
    {
        detailsFields[key] = value;
    }

    private string GetBankNameFromAccountType(string accountType)
    {
        if (accountType.StartsWith("SCB"))
            return "SCB";

        if (accountType.StartsWith("KTB"))
            return "KTB";

        return accountType;
    }
    private bool IsPersonalBank(string type)
    {
        return type == "SCB บุคคล"
            || type == "KTB บุคคล"
            || type == "BAY บุคคล"
            || type == "GSB บุคคล"
            || type == "BAAC บุคคล"
            || type == "BBL บุคคล";
    }

    private bool IsBizBank(string type)
    {
        return type == "KBANK บุคคล"
            || type == "KBANK นิติ"
            || type == "BAY นิติ"
            || type == "KTB นิติ"
            || type == "TTB นิติ";
    }

    private bool IsDualApprovalBank(string type)
    {
        return type == "GSB นิติ"
            || type == "KKP นิติ";
    }
    private void ResetFormByType()
    {
        detailsFields.Clear();

        if (newAccount.AccountType == "SCB นิติ")
        {   
            detailsFields["CitizenId"] = "";
            detailsFields["BirthDate"] = "";
            detailsFields["CompanyNo"] = "";
            detailsFields["TokenPin"] = "";
            detailsFields["PhoneNetwork"] = "";
            detailsFields["Phone"] = "";
            detailsFields["SimExpire"] = "";
            detailsFields["ScbUser"] = "";
            detailsFields["ScbPass"] = "";
            detailsFields["Email"] = "";
            detailsFields["EmailPass"] = "";
            detailsFields["AppCode"] = "";
            detailsFields["Address"] = "";
            detailsFields["ReceivedDate"] = DateTime.Today.ToString("yyyy-MM-dd");
            detailsFields["ReleasedDate"] = "";
        }

        if (IsPersonalBank(newAccount.AccountType) ||
            IsBizBank(newAccount.AccountType))
{
            detailsFields["PhoneNetwork"] = "";
            detailsFields["BookBank"] = "";
            detailsFields["ReceivedDate"] = DateTime.Today.ToString("yyyy-MM-dd");
            detailsFields["ReleasedDate"] = "";
            detailsFields["CitizenId"] = "";
            detailsFields["BirthDate"] = "";
            detailsFields["CompanyNo"] = "";
            detailsFields["AtmNumber"] = "";
            detailsFields["AtmPin"] = "";
            detailsFields["CompanyNo"] = "";
            detailsFields["CompanyCode"] = "";
            detailsFields["Phone"] = "";
            detailsFields["SimExpire"] = "";
            detailsFields["Limit"] = "";
            detailsFields["Email"] = "";
            detailsFields["EmailPass"] = "";
            detailsFields["AppCode"] = "";
            detailsFields["Address"] = "";
            detailsFields["ReceivedDate"] = DateTime.Today.ToString("yyyy-MM-dd");
            detailsFields["ReleasedDate"] = "";
        }

        if (IsDualApprovalBank(newAccount.AccountType))
        {
            detailsFields["CitizenId"] = "";
            detailsFields["BirthDate"] = "";
            detailsFields["CompanyNo"] = "";

            detailsFields["MakerPhoneNetwork"] = "";
            detailsFields["MakerPhone"] = "";
            detailsFields["MakerSimExpire"] = "";
            detailsFields["MakerEmail"] = "";
            detailsFields["MakerEmailPass"] = "";
            detailsFields["MakerUser"] = "";
            detailsFields["MakerPass"] = "";
            detailsFields["MakerCompanyCode"] = "";

            detailsFields["ApproverPhoneNetwork"] = "";
            detailsFields["ApproverPhone"] = "";
            detailsFields["ApproverSimExpire"] = "";
            detailsFields["ApproverEmail"] = "";
            detailsFields["ApproverEmailPass"] = "";
            detailsFields["ApproverUser"] = "";
            detailsFields["ApproverPass"] = "";
            detailsFields["ApproverCompanyCode"] = "";

            detailsFields["AppCode"] = "";
            detailsFields["Address"] = "";
            detailsFields["ReceivedDate"] = DateTime.Today.ToString("yyyy-MM-dd");
            detailsFields["ReleasedDate"] = "";
        }
    }

    private void ConfirmDelete(BankAccount account)
    {
        accountToDelete = account;
        showDeleteModal = true;
    }

    private void CancelDelete()
    {
        accountToDelete = null;
        showDeleteModal = false;
    }

    private void ConfirmDeleteGroup(string groupName)
    {
        groupToDelete = groupName;
        showDeleteGroupModal = true;
    }

    private void CancelDeleteGroup()
    {
        groupToDelete = "";
        showDeleteGroupModal = false;
    }

    private async Task DeleteConfirmed()
    {
        if (isDeleting)
            return;

        if (accountToDelete == null)
            return;

        isDeleting = true;

        try
        {
            await SupabaseService.Client
                .From<BankAccount>()
                .Delete(accountToDelete);

            await LoadData();

            accountToDelete = null;
            showDeleteModal = false;
        }
        catch (Exception ex)
        {
            warningMessage = "❌ " + ex.Message;
        }
        finally
        {
            isDeleting = false;
        }
    }
    private async Task DeleteGroupConfirmed()
    {
        if (isDeletingGroup)
            return;

        if (string.IsNullOrWhiteSpace(groupToDelete))
            return;

        isDeletingGroup = true;
        warningMessage = "";

        try
        {
            var accountsInGroup = bankAccounts
                .Where(x => x.GroupName == groupToDelete)
                .ToList();

            foreach (var account in accountsInGroup)
            {
                account.GroupName = "";

                await SupabaseService.Client
                    .From<BankAccount>()
                    .Update(account);
            }

            var group = bankGroups
                .FirstOrDefault(x => x.GroupName == groupToDelete);

            if (group != null)
            {
                await SupabaseService.Client
                    .From<BankGroup>()
                    .Delete(group);
            }

            selectedGroup = "";

            groupToDelete = "";
            showDeleteGroupModal = false;

            await LoadData();
        }
        catch (Exception ex)
        {
            warningMessage = "❌ " + ex.Message;
        }
        finally
        {
            isDeletingGroup = false;
        }
    }

    private void OpenAddGroupModal()
    {
        newGroupName = "";
        showAddGroupModal = true;
    }

    private void CloseAddGroupModal()
    {
        showAddGroupModal = false;
    }

    private async Task SaveGroupName()
    {
        if (string.IsNullOrWhiteSpace(newGroupName))
        {
            warningMessage = "กรุณากรอกชื่อสายบัญชี";
            return;
        }

        var groupName = newGroupName.Trim();

        if (Groups.Contains(groupName))
        {
            warningMessage = "มีสายบัญชีนี้อยู่แล้ว";
            return;
        }

        try
        {
            var group = new BankGroup
            {
                GroupName = groupName
            };

            await SupabaseService.Client
                .From<BankGroup>()
                .Insert(group);

            await LoadData();

            showAddGroupModal = false;
            newGroupName = "";
        }
        catch (Exception ex)
        {
            warningMessage = "❌ " + ex.Message;
        }
    }

    private void OpenAddModal()
    {
        warningMessage = "";
        detailsFields.Clear();

        isEditMode = false;
        editingAccount = null;

        newAccount = new BankAccount
        {
            GroupName = "",
            BankName = "",
            AccountType = "",
            AccountName = "",
            OwnerName = "",
            AccountNumber = "",
            Branch = "",
            Note = "",
            Status = "พร้อมใช้งาน",
            StatusNote = ""
        };

        showAddModal = true;
    }

    private void CloseAddModal()
    {
        showAddModal = false;
        isEditMode = false;
        editingAccount = null;
        detailsFields.Clear();
    }

    private List<string> Groups =>
    bankGroups
        .Select(x => x.GroupName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .OrderBy(x => x)
        .ToList();

    private IEnumerable<BankAccount> FilteredAccounts =>
        bankAccounts.Where(x =>
            (string.IsNullOrWhiteSpace(selectedGroup) || x.GroupName == selectedGroup) &&
            (string.IsNullOrWhiteSpace(searchText) ||
             x.GroupName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             x.BankName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             x.AccountName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             x.AccountNumber.Contains(searchText, StringComparison.OrdinalIgnoreCase)));

    private void OpenDetail(BankAccount account)
    {
        selectedAccount = account;
    }

    private void CloseDetail()
    {
        selectedAccount = null;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsLoggedIn)
        {
            Nav.NavigateTo("/");
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            loadError = "";

            var result = await SupabaseService.Client
                .From<BankAccount>()
                .Get();

            bankAccounts = result.Models ?? new List<BankAccount>();

            var groupResult = await SupabaseService.Client
                .From<BankGroup>()
                .Get();

            bankGroups = groupResult.Models ?? new List<BankGroup>();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAccount()
{
    if (isSaving)
        return;

    warningMessage = "";

    if (string.IsNullOrWhiteSpace(newAccount.GroupName) ||
        string.IsNullOrWhiteSpace(newAccount.AccountType) ||
        string.IsNullOrWhiteSpace(newAccount.AccountName) ||
        string.IsNullOrWhiteSpace(newAccount.AccountNumber))
    {
        warningMessage = "กรุณากรอกข้อมูลให้ครบ";
        return;
    }

    isSaving = true;

    try
    {
        var bankName = GetBankNameFromAccountType(newAccount.AccountType);

        var accountToInsert = new BankAccount
        {
            Id = newAccount.Id,
            GroupName = newAccount.GroupName.Trim(),
            BankName = bankName,
            AccountType = newAccount.AccountType.Trim(),
            AccountName = newAccount.AccountName.Trim(),
            OwnerName = newAccount.OwnerName?.Trim() ?? "",
            AccountNumber = newAccount.AccountNumber.Trim(),
            Branch = newAccount.Branch?.Trim() ?? "",
            Note = newAccount.Note?.Trim() ?? "",

            Status = string.IsNullOrWhiteSpace(newAccount.Status)
                ? "พร้อมใช้งาน"
                : newAccount.Status,

                StatusNote = newAccount.StatusNote?.Trim() ?? "",

            DetailsJson = JsonSerializer.Serialize(detailsFields)
        };

        // =========================
        // EDIT MODE
        // =========================

        if (isEditMode && editingAccount != null)
        {
            accountToInsert.Id = editingAccount.Id;

            await SupabaseService.Client
                .From<BankAccount>()
                .Update(accountToInsert);
        }

        // =========================
        // ADD MODE
        // =========================

        else
        {
            accountToInsert.Id = Guid.NewGuid();

            await SupabaseService.Client
                .From<BankAccount>()
                .Insert(accountToInsert);
        }

        await LoadData();

        showAddModal = false;

        newAccount = new BankAccount();
        newAccount.AccountType = "";
        newAccount.Status = "พร้อมใช้งาน";

        detailsFields.Clear();

        isEditMode = false;
        editingAccount = null;
    }
    catch (Exception ex)
    {
        warningMessage = "❌ " + ex.Message;
    }
    finally
    {
        isSaving = false;
    }
}
    
    private string FormatThaiDate(DateTime date)
    {
        string[] months =
        {
            "ม.ค.", "ก.พ.", "มี.ค.", "เม.ย.",
            "พ.ค.", "มิ.ย.", "ก.ค.", "ส.ค.",
            "ก.ย.", "ต.ค.", "พ.ย.", "ธ.ค."
        };

        return $"{date.Day} {months[date.Month - 1]} {date.Year + 543}";
    }

    
