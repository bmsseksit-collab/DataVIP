@page "/external-reports"

@using DataVipWeb.Models
@using DataVipWeb.Services

@inject SupabaseService SupabaseService
@inject ExternalApiService ExternalApiService
@inject NavigationManager Nav

<div class="external-page">

    <div class="page-header">
        <div>
            <h1>การใช้งานบัญชี</h1>
            <p>สรุปยอดฝากตามบัญชีจากเว็บภายนอก</p>
        </div>

        <div class="header-actions">
            <input type="date"
                   class="date-input"
                   @bind="selectedDate" />

            <button class="sync-btn"
                    disabled="@isLoading"
                    @onclick="SyncBmReports">
                @(isLoading ? "กำลัง Sync..." : "Sync ข้อมูล BM")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @(isError ? "error" : "success")">
            @message
        </div>
    }
    @{
        var depositReports = reports
            .Where(x => !x.GroupName.Contains("ถอน"))
            .ToList();
    }
    <div class="summary-grid">
        <div class="summary-card">
            <span>จำนวนบัญชีฝาก</span>
            <b>@depositReports.Count</b>
        </div>

        <div class="summary-card">
            <span>จำนวนรายการฝาก</span>
            <b>@depositReports.Sum(x => x.TransactionCount).ToString("N0")</b>
        </div>

        <div class="summary-card">
            <span>ยอดฝากรวม</span>
            <b>@depositReports.Sum(x => x.TotalAmount).ToString("N2")</b>
        </div>

        <div class="summary-card site-card">
            <span>เว็บ</span>
            <b>BM</b>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-box">
            กำลังโหลดข้อมูล...
        </div>
    }
    else if (!reports.Any())
    {
        <div class="empty-box">
            ยังไม่มีข้อมูล กรุณากด Sync ข้อมูล BM
        </div>
    }
    else
    {
        <div class="site-title">
            <div class="site-badge">BM</div>
            <h2>สรุปการใช้งานบัญชี BM</h2>
        </div>

        <div class="report-grid">
            @foreach (var group in reports.GroupBy(x => x.GroupName))
            {
                var selectedBank = GetBankFilter(group.Key);

                var bankOptions = group
                    .Select(x => x.BankName)
                    .Where(x => !string.IsNullOrWhiteSpace(x))
                    .Distinct()
                    .OrderBy(x => x)
                    .ToList();

                var filteredGroup = string.IsNullOrWhiteSpace(selectedBank)
                    ? group.ToList()
                    : group.Where(x => x.BankName == selectedBank).ToList();

                <div class="report-card">
                    <div class="report-card-header">
                        <h3>@group.Key</h3>

                        <div class="report-card-header-right">

                            <select class="bank-filter"
                                    value="@selectedBank"
                                    @onchange="e => SetBankFilter(group.Key, e)">

                                <option value="">ทุกธนาคาร</option>

                                @foreach (var bank in bankOptions)
                                {
                                    <option value="@bank">@bank</option>
                                }

                            </select>

                            <span>@filteredGroup.Count() บัญชี</span>

                        </div>
                    </div>

                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>ลำดับ</th>
                                    <th>ธนาคาร</th>
                                    <th>ชื่อบัญชี</th>
                                    <th>รายการ</th>
                                    <th>ยอดเข้าไป</th>
                                </tr>
                            </thead>

                            <tbody>
                                @{
                                    var index = 1;
                                }

                                @foreach (var item in filteredGroup)
                                {
                                    <tr>
                                        <td>@index</td>

                                        <td>
                                            <span class="bank-badge">
                                                @item.BankName
                                            </span>
                                        </td>

                                        <td>@item.AccountName</td>

                                        <td>@item.TransactionCount.ToString("N0")</td>

                                        <td>@item.TotalAmount.ToString("N2")</td>
                                    </tr>

                                    index++;
                                }

                                <tr class="total-row">
                                    <td colspan="3">รวม</td>
                                    <td>@filteredGroup.Sum(x => x.TransactionCount).ToString("N0")</td>
                                    <td>@filteredGroup.Sum(x => x.TotalAmount).ToString("N2")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }

</div>

@code {
    private DateTime selectedDate = DateTime.Today;
    private List<ExternalBankReport> reports = new();
    private List<ExternalReportSummary> summaries = new();

    private bool isLoading = false;
    private bool isError = false;
    private string message = "";

    private Dictionary<string, string> bankFilters = new();

    private string GetBankFilter(string groupName)
    {
        return bankFilters.TryGetValue(groupName, out var value)
            ? value
            : "";
    }

    private void SetBankFilter(string groupName, ChangeEventArgs e)
    {
        bankFilters[groupName] = e.Value?.ToString() ?? "";
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsLoggedIn)
        {
            Nav.NavigateTo("/");
            return;
        }

        await LoadReports();
    }

    private DateTime GetApiDate()
    {
        return selectedDate.Year > 2500
            ? selectedDate.AddYears(-543).Date
            : selectedDate.Date;
    }

    private async Task LoadReports()
    {
        isLoading = true;
        message = "";
        isError = false;

        try
        {
            var apiSelectedDate = GetApiDate();

            var sites = await SupabaseService.Client
                .From<ExternalSite>()
                .Get();

            var site = sites.Models
                .FirstOrDefault(x => x.SiteCode == "BM");

            if (site == null)
            {
                reports = new();
                summaries = new();
                message = "ยังไม่พบข้อมูลเว็บ BM ใน external_sites";
                isError = true;
                return;
            }

            var result = await SupabaseService.Client
                .From<ExternalBankReport>()
                .Where(x => x.SiteId == site.Id)
                .Where(x => x.ReportDate == apiSelectedDate)
                .Get();

            reports = result.Models
                .OrderBy(x => x.GroupName)
                .ToList();

            var summaryResult = await SupabaseService.Client
                .From<ExternalReportSummary>()
                .Where(x => x.SiteId == site.Id)
                .Where(x => x.ReportDate == apiSelectedDate)
                .Get();

            summaries = summaryResult.Models.ToList();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SyncBmReports()
    {
        isLoading = true;
        message = "";
        isError = false;

        try
        {
            var apiSelectedDate = GetApiDate();

            var sites = await SupabaseService.Client
                .From<ExternalSite>()
                .Get();

            var site = sites.Models
                .FirstOrDefault(x => x.SiteCode == "BM");

            if (site == null)
                throw new Exception("ยังไม่พบเว็บ BM ใน external_sites");

            if (string.IsNullOrWhiteSpace(site.BearerToken))
                throw new Exception("ยังไม่ได้ใส่ Bearer Token ของเว็บ BM ใน external_sites");

            // ลบข้อมูล BM เก่าทั้งหมดก่อน ไม่สนวันที่
            var oldReports = await SupabaseService.Client
                .From<ExternalBankReport>()
                .Where(x => x.SiteId == site.Id)
                .Get();

            foreach (var old in oldReports.Models)
            {
                await SupabaseService.Client
                    .From<ExternalBankReport>()
                    .Where(x => x.Id == old.Id)
                    .Delete();
            }

            var oldSummaries = await SupabaseService.Client
                .From<ExternalReportSummary>()
                .Where(x => x.SiteId == site.Id)
                .Get();

            foreach (var old in oldSummaries.Models)
            {
                await SupabaseService.Client
                    .From<ExternalReportSummary>()
                    .Where(x => x.Id == old.Id)
                    .Delete();
            }

            // โหลดข้อมูลใหม่ตามวันที่ที่เลือก
            var syncResult = await ExternalApiService.GetBmReportsAsync(site, apiSelectedDate);

            var newReports = syncResult.Reports;
            var newSummaries = syncResult.Summaries;

            // Insert ข้อมูลชุดใหม่
            if (newReports.Any())
            {
                await SupabaseService.Client
                    .From<ExternalBankReport>()
                    .Insert(newReports);
            }

            if (newSummaries.Any())
            {
                await SupabaseService.Client
                    .From<ExternalReportSummary>()
                    .Insert(newSummaries);
            }

            reports = newReports
                .OrderBy(x => x.GroupName)
                .ToList();

            summaries = newSummaries;

            message = $"Sync สำเร็จ {reports.Count} รายการ";
            isError = false;
        }
        catch (Exception ex)
        {
            message = ex.Message;
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }
}

