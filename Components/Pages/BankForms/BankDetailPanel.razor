@using DataVipWeb.Models
@using DataVipWeb.Components.Pages.BankForms

@if (Account != null)
{
    <div class="modal-overlay">
        <div class="modal-box detail-modal-box">
            <button class="detail-floating-close" @onclick="OnClose">
                ×
            </button>

            <div class="modal-header">

                <div class="header-left">
                    <h2>
                        รายละเอียดบัญชี
                        <span class="detail-title-group">@Account.GroupName</span>
                    </h2>
                </div>

                <div class="header-right">

                   

                    @if (!string.IsNullOrWhiteSpace(Account.Status))
                    {
                        <div class="detail-status-box">

                            <span class="@BankDetailHelper.GetStatusClass(Account.Status)">
                                @Account.Status
                            </span>

                            @if (Account.Status != "พร้อมใช้งาน" &&
                                 !string.IsNullOrWhiteSpace(Account.StatusNote))
                            {
                                <div class="detail-note-badge">
                                    @Account.StatusNote
                                </div>
                            }

                        </div>
                    }

                </div>

            </div>

            <div class="detail-bank-head">
                <div class="bank-logo-big">
                    <img src="@BankDetailHelper.GetBankLogo(Account.BankName)" />
                </div>

                <div>
                    <h3>@BankDetailHelper.GetBankShortName(Account.BankName)</h3>
                    <p>
                        <span class="bank-type-pill @BankDetailHelper.GetBankThemeClass(Account.BankName)">
                            @Account.AccountType
                        </span>
                    </p>
                </div>
            </div>

            @{
                var detailData = BankDetailBuilder.Build(Account);
            }

            <div class="detail-grid-table">
                @foreach (var item in detailData.NormalRows)
                {
                    <div class="detail-cell label @BankDetailHelper.GetBankThemeClass(Account.BankName) @GetDetailRowTheme(item.Label)">
                        @item.Label
                    </div>
                    <div class="detail-cell value">@item.Value</div>
                }
            </div>

            @if (detailData.BottomRows.Any())
            {
                <div class="detail-bottom-table">
                    @foreach (var item in detailData.BottomRows)
                    {
                        <div class="detail-cell label @BankDetailHelper.GetBankThemeClass(Account.BankName) @GetDetailRowTheme(item.Label)">
                            @item.Label
                        </div>
                        <div class="detail-cell value">@item.Value</div>
                    }
                </div>
            }

            <button class="close-detail-btn" @onclick="OnClose">
                ปิด
            </button>

        </div>
    </div>
}

@code {
    [Parameter] public BankAccount? Account { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string GetDetailRowTheme(string label)
    {
        if (label.Contains("(ผู้ทำ)"))
            return "theme-maker";

        if (label.Contains("(ผู้อนุมัติ)"))
            return "theme-approver";

        return "";
    }
}
