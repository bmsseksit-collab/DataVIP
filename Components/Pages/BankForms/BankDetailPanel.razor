@using DataVipWeb.Models
@using System.Text.Json

@if (Account != null)
{
    <div class="modal-overlay">
        <div class="modal-box detail-modal-box">

            <div class="modal-header">
                <h2>
                    รายละเอียดบัญชี
                    <span class="detail-title-group">@Account.GroupName</span>
                </h2>

                <button class="modal-close" @onclick="OnClose">×</button>
            </div>

            <div class="detail-bank-head">
                <div class="bank-logo-big">🏦</div>

                <div>
                    <h3>@Account.BankName</h3>
                    <p>@Account.AccountType</p>
                </div>
            </div>

            @{
                var mainRows = new List<(string Label, string Value)>();

                if (!string.IsNullOrWhiteSpace(Account.AccountName))
                    mainRows.Add(("ชื่อบัญชี", Account.AccountName));

                if (!string.IsNullOrWhiteSpace(Account.OwnerName))
                    mainRows.Add(("ชื่อเจ้าของบัญชี", Account.OwnerName));

                var citizenId = GetRawDetail("CitizenId");
                if (!string.IsNullOrWhiteSpace(citizenId))
                    mainRows.Add(("เลขบัตรประชาชน", FormatValue("CitizenId", citizenId)));

                var birthDate = GetRawDetail("BirthDate");
                if (!string.IsNullOrWhiteSpace(birthDate))
                    mainRows.Add(("วันเกิด", FormatValue("BirthDate", birthDate)));

                if (!string.IsNullOrWhiteSpace(Account.Branch))
                    mainRows.Add(("สาขา", Account.Branch));

                if (!string.IsNullOrWhiteSpace(Account.AccountNumber))
                    mainRows.Add(("เลขบัญชี", Account.AccountNumber));

                // =========================
                // รายละเอียดเพิ่มเติม
                // =========================

                var normalDetails = new List<(string Label, string Value)>();

                // =========================
                // SCB นิติ
                // =========================

                if (Account.AccountType == "SCB นิติ")
                {
                    var scbCorporateOrder = new[]
                    {
        "CompanyNo",
        "TokenPin",
        "Phone",
        "SimExpire",
        "ScbUser",
        "ScbPass",
        "Email",
        "EmailPass",
        "AppCode"
    };

                    foreach (var key in scbCorporateOrder)
                    {
                        // เบอร์โทร + เครือข่าย
                        if (key == "Phone")
                        {
                            var phoneNetwork = GetRawDetail("PhoneNetwork");
                            var phone = GetRawDetail("Phone");

                            if (!string.IsNullOrWhiteSpace(phone))
                            {
                                normalDetails.Add((
                                    string.IsNullOrWhiteSpace(phoneNetwork)
                                        ? "เบอร์โทร"
                                        : $"เบอร์ {phoneNetwork}",
                                    phone
                                ));
                            }

                            continue;
                        }

                        var value = GetRawDetail(key);

                        if (!string.IsNullOrWhiteSpace(value))
                        {
                            normalDetails.Add((
                                GetLabel(key),
                                FormatValue(key, value)
                            ));
                        }
                    }
                }

                // =========================
                // บุคคลทั่วไป
                // =========================

                else
                {
                    var personalOrder = new[]
                    {
                        "AtmNumber",
                        "AtmPin",
                        "Phone",
                        "SimExpire",
                        "Limit",
                        "BookBank",
                        "Email",
                        "EmailPass",
                        "AppCode"
                    };

                    foreach (var key in personalOrder)
                    {
                        if (key == "Phone")
                        {
                            var phoneNetwork = GetRawDetail("PhoneNetwork");
                            var phone = GetRawDetail("Phone");

                            if (!string.IsNullOrWhiteSpace(phone))
                            {
                                normalDetails.Add((
                                    string.IsNullOrWhiteSpace(phoneNetwork)
                                        ? "เบอร์โทร"
                                        : $"เบอร์ {phoneNetwork}",
                                    phone
                                ));
                            }

                            continue;
                        }

                        var value = GetRawDetail(key);

                        if (!string.IsNullOrWhiteSpace(value))
                        {
                            normalDetails.Add((
                                GetLabel(key),
                                FormatValue(key, value)
                            ));
                        }
                    }
                }

                // หมายเหตุ
                if (!string.IsNullOrWhiteSpace(Account.Note))
                    normalDetails.Add(("หมายเหตุ", Account.Note));

                // =========================
                // ล่างสุด
                // =========================

                var bottomDetails = new List<(string Label, string Value)>();

                var address = GetRawDetail("Address");
                if (!string.IsNullOrWhiteSpace(address))
                {
                    bottomDetails.Add((
                        "ที่อยู่",
                        FormatValue("Address", address)
                    ));
                }

                var receivedDate = GetRawDetail("ReceivedDate");
                if (!string.IsNullOrWhiteSpace(receivedDate))
                {
                    bottomDetails.Add((
                        "วันที่รับบัญชี",
                        FormatValue("ReceivedDate", receivedDate)
                    ));
                }

                var releasedDate = GetRawDetail("ReleasedDate");
                if (!string.IsNullOrWhiteSpace(releasedDate))
                {
                    bottomDetails.Add((
                        "วันที่ปล่อยใช้งาน",
                        FormatValue("ReleasedDate", releasedDate)
                    ));
                }

                var allNormalRows = mainRows.Concat(normalDetails).ToList();
            }

            <div class="detail-grid-table">
                @foreach (var item in allNormalRows)
                {
                    <div class="detail-cell label">@item.Label</div>
                    <div class="detail-cell value">@item.Value</div>
                }
            </div>

            @if (bottomDetails.Any())
            {
                <div class="detail-bottom-table">
                    @foreach (var item in bottomDetails)
                    {
                        <div class="detail-cell label">@item.Label</div>
                        <div class="detail-cell value">@item.Value</div>
                    }
                </div>
            }

            <button class="close-detail-btn" @onclick="OnClose">
                ปิด
            </button>

        </div>
    </div>
}

@code {
    [Parameter] public BankAccount? Account { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string GetRawDetail(string key)
    {
        return Details.ContainsKey(key) ? Details[key] : "";
    }

    private Dictionary<string, string> Details
    {
        get
        {
            if (Account == null || string.IsNullOrWhiteSpace(Account.DetailsJson))
                return new();

            try
            {
                return JsonSerializer.Deserialize<Dictionary<string, string>>(Account.DetailsJson) ?? new();
            }
            catch
            {
                return new();
            }
        }
    }

    private string Show(string? value)
    {
        return value ?? "";
    }

    private string FormatValue(string key, string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "-";

        if (key.Contains("Date") || key.Contains("Expire"))
        {
            if (DateTime.TryParse(value, out var date))
                return FormatThaiDate(date);
        }

        return value;
    }

    private string GetLabel(string key)
    {
        return key switch
        {
            "CitizenId" => "เลขบัตรประชาชน",
            "BirthDate" => "วันเกิด",
            "CompanyNo" => "ทะเบียนนิติบุคคล",
            "TokenPin" => "SCB Digital Token PIN",
            "AtmNumber" => "เลขบัตร ATM",
            "AtmPin" => "รหัส ATM",
            "PhoneNetwork" => "เครือข่าย",
            "Phone" => "เบอร์โทร",
            "SimExpire" => "วันหมดอายุซิม",
            "BizUser" => "Biz Username",
            "BizPass" => "Biz Password",
            "ScbUser" => "SCB Username",
            "ScbPass" => "SCB Password",
            "Limit" => "วงเงิน",
            "BookBank" => "สมุดบัญชี",
            "Email" => "Email",
            "EmailPass" => "Email Password",
            "AppCode" => "รหัส APP",
            "Address" => "ที่อยู่",
            "ReceivedDate" => "วันที่รับบัญชี",
            "ReleasedDate" => "วันที่ปล่อยใช้งาน",
            _ => key
        };
    }

    private string FormatThaiDate(DateTime date)
    {
        string[] months =
        {
            "ม.ค.", "ก.พ.", "มี.ค.", "เม.ย.",
            "พ.ค.", "มิ.ย.", "ก.ค.", "ส.ค.",
            "ก.ย.", "ต.ค.", "พ.ย.", "ธ.ค."
        };

        return $"{date.Day} {months[date.Month - 1]} {date.Year + 543}";
    }
}
<style>
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(9, 0, 31, 0.58);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 99999;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .modal-close {
        border: none;
        background: #f3e8ff;
        color: #6d28ff;
        width: 34px;
        height: 34px;
        border-radius: 10px;
        font-size: 24px;
        cursor: pointer;
    }

    .bank-logo-big {
        width: 74px;
        height: 74px;
        border-radius: 50%;
        background: #f3e8ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 38px;
        margin: 10px 0;
    }


    .close-detail-btn {
        width: 100%;
        margin-top: 20px;
        border: none;
        background: linear-gradient(90deg,#6d28ff,#9333ea);
        color: white;
        padding: 13px;
        border-radius: 14px;
        font-weight: 900;
        cursor: pointer;
    }

    .detail-title-group {
        color: #7c3aed;
        font-size: 22px;
        margin-left: 8px;
    }

    .detail-bank-head {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 16px;
    }

        .detail-bank-head h3 {
            margin: 0;
            color: #1e1b4b;
            font-size: 28px;
            font-weight: 900;
        }

        .detail-bank-head p {
            margin: 4px 0 0;
            color: #7c3aed;
            font-weight: 800;
        }

    .detail-modal-box {
        width: fit-content;
        min-width: 480px;
        max-width: 94vw;
        max-height: 86vh;
        overflow-y: auto;
        background: white;
        border-radius: 24px;
        padding: 24px;
        box-shadow: 0 25px 60px rgba(0,0,0,.18);
    }

    .detail-grid-table {
        display: grid;
        grid-template-columns: max-content minmax(220px,1fr);
        border-top: 1px solid #ded6f7;
        border-left: 1px solid #ded6f7;
    }

    .detail-bottom-table {
        display: grid;
        grid-template-columns: max-content minmax(220px,1fr);
        border-top: 1px solid #ded6f7;
        border-left: 1px solid #ded6f7;
        margin-top: 8px;
    }

    .detail-cell {
        border-right: 1px solid #ded6f7;
        border-bottom: 1px solid #ded6f7;
        padding: 6px 8px;
        font-size: 12px;
        min-height: 30px;
        word-break: break-word;
        overflow-wrap: anywhere;
    }

        .detail-cell.label {
            background: #ede3ff;
            color: #4c1d95;
            font-weight: 900;
        }

        .detail-cell.value {
            color: #1e1b4b;
            font-weight: 800;
            text-align: center;
        }

</style>