@using DataVipWeb.Models

<div class="form-section-title">
    ข้อมูลหลักบัญชี
</div>

<input placeholder="ชื่อบัญชี" @bind="Account.AccountName" />
<input placeholder="ชื่อเจ้าของบัญชี" @bind="Account.OwnerName" />

<input placeholder="เลขบัตรประชาชน"
       value="@GetDetailValue("CitizenId")"
       @oninput='e => SetDetailValue("CitizenId", e.Value?.ToString() ?? "")' />

<input placeholder="วัน/เดือน/ปี เกิด"
       value="@GetDetailValue("BirthDate")"
       @oninput='e => SetDetailValue("BirthDate", e.Value?.ToString() ?? "")' />

<input placeholder="สาขา" @bind="Account.Branch" />
<input placeholder="เลขบัญชี" @bind="Account.AccountNumber" />

<input placeholder="ทะเบียนนิติบุคคลเลขที่"
       value="@GetDetailValue("CompanyNo")"
       @oninput='e => SetDetailValue("CompanyNo", e.Value?.ToString() ?? "")' />

<div class="form-section-title">ข้อมูลผู้ทำรายการ</div>

<div class="phone-row">
    <select value="@GetDetailValue("MakerPhoneNetwork")"
            @onchange='e => SetDetailValue("MakerPhoneNetwork", e.Value?.ToString() ?? "")'>
        <option value="">เครือข่าย</option>
        <option value="AIS">AIS</option>
        <option value="DTAC">DTAC</option>
        <option value="TRUE">TRUE</option>
        <option value="รายเดือน">รายเดือน</option>
    </select>

    <input placeholder="เบอร์ผู้ทำ"
           value="@GetDetailValue("MakerPhone")"
           @oninput='e => SetDetailValue("MakerPhone", e.Value?.ToString() ?? "")' />
</div>

<input placeholder="วันหมดอายุซิมผู้ทำ"
       value="@GetDetailValue("MakerSimExpire")"
       @oninput='e => SetDetailValue("MakerSimExpire", e.Value?.ToString() ?? "")' />

<input placeholder="Email ผู้ทำ"
       value="@GetDetailValue("MakerEmail")"
       @oninput='e => SetDetailValue("MakerEmail", e.Value?.ToString() ?? "")' />

<input placeholder="Email Password ผู้ทำ"
       value="@GetDetailValue("MakerEmailPass")"
       @oninput='e => SetDetailValue("MakerEmailPass", e.Value?.ToString() ?? "")' />

<input placeholder="@GetUserLabel("ผู้ทำ")"
       value="@GetDetailValue("MakerUser")"
       @oninput='e => SetDetailValue("MakerUser", e.Value?.ToString() ?? "")' />

<input placeholder="@GetPassLabel("ผู้ทำ")"
       value="@GetDetailValue("MakerPass")"
       @oninput='e => SetDetailValue("MakerPass", e.Value?.ToString() ?? "")' />

<input placeholder="รหัสบริษัท ผู้ทำ"
       value="@GetDetailValue("MakerCompanyCode")"
       @oninput='e => SetDetailValue("MakerCompanyCode", e.Value?.ToString() ?? "")' />

<div class="form-section-title">ข้อมูลผู้อนุมัติรายการ</div>

<div class="phone-row">
    <select value="@GetDetailValue("ApproverPhoneNetwork")"
            @onchange='e => SetDetailValue("ApproverPhoneNetwork", e.Value?.ToString() ?? "")'>
        <option value="">เครือข่าย</option>
        <option value="AIS">AIS</option>
        <option value="DTAC">DTAC</option>
        <option value="TRUE">TRUE</option>
        <option value="รายเดือน">รายเดือน</option>
    </select>

    <input placeholder="เบอร์ผู้อนุมัติ"
           value="@GetDetailValue("ApproverPhone")"
           @oninput='e => SetDetailValue("ApproverPhone", e.Value?.ToString() ?? "")' />
</div>

<input placeholder="วันหมดอายุซิมผู้อนุมัติ"
       value="@GetDetailValue("ApproverSimExpire")"
       @oninput='e => SetDetailValue("ApproverSimExpire", e.Value?.ToString() ?? "")' />

<input placeholder="Email ผู้อนุมัติ"
       value="@GetDetailValue("ApproverEmail")"
       @oninput='e => SetDetailValue("ApproverEmail", e.Value?.ToString() ?? "")' />

<input placeholder="Email Password ผู้อนุมัติ"
       value="@GetDetailValue("ApproverEmailPass")"
       @oninput='e => SetDetailValue("ApproverEmailPass", e.Value?.ToString() ?? "")' />

<input placeholder="@GetUserLabel("ผู้อนุมัติ")"
       value="@GetDetailValue("ApproverUser")"
       @oninput='e => SetDetailValue("ApproverUser", e.Value?.ToString() ?? "")' />

<input placeholder="@GetPassLabel("ผู้อนุมัติ")"
       value="@GetDetailValue("ApproverPass")"
       @oninput='e => SetDetailValue("ApproverPass", e.Value?.ToString() ?? "")' />

<input placeholder="รหัสบริษัท ผู้อนุมัติ"
       value="@GetDetailValue("ApproverCompanyCode")"
       @oninput='e => SetDetailValue("ApproverCompanyCode", e.Value?.ToString() ?? "")' />

<input placeholder="@GetAppCodeLabel()"
       value="@GetDetailValue("AppCode")"
       @oninput='e => SetDetailValue("AppCode", e.Value?.ToString() ?? "")' />

<input placeholder="ที่อยู่"
       value="@GetDetailValue("Address")"
       @oninput='e => SetDetailValue("Address", e.Value?.ToString() ?? "")' />

<div class="date-input-box">
    <span class="date-label">วันที่รับบัญชี</span>
    <input type="date"
           class="date-input"
           value="@GetDetailValue("ReceivedDate")"
           @oninput='e => SetDetailValue("ReceivedDate", e.Value?.ToString() ?? DateTime.Today.ToString("yyyy-MM-dd"))' />
</div>

<input placeholder="วันที่ปล่อยใช้งาน"
       value="@GetDetailValue("ReleasedDate")"
       @oninput='e => SetDetailValue("ReleasedDate", e.Value?.ToString() ?? "")' />

@code {
    [Parameter] public BankAccount Account { get; set; } = new();
    [Parameter] public string AccountType { get; set; } = "";
    [Parameter] public Func<string, string> GetDetailValue { get; set; } = default!;
    [Parameter] public Action<string, string> SetDetailValue { get; set; } = default!;

    private string GetUserLabel(string role)
    {
        if (AccountType.StartsWith("KKP"))
            return $"KKP User {role}";

        return $"GSB User {role}";
    }

    private string GetPassLabel(string role)
    {
        if (AccountType.StartsWith("KKP"))
            return $"KKP Pass {role}";

        return $"GSB Pass {role}";
    }

    private string GetAppCodeLabel()
    {
        if (AccountType.StartsWith("KKP"))
            return "รหัส KKP BIZ";

        return "รหัส APP";
    }
}