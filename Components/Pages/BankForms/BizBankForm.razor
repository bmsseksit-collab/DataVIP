@using DataVipWeb.Models

<div class="form-section-title">
    ข้อมูลหลักบัญชี
</div>

<input placeholder="ชื่อบัญชี" @bind="Account.AccountName" />
<input placeholder="ชื่อเจ้าของบัญชี" @bind="Account.OwnerName" />

<input placeholder="เลขบัตรประชาชน"
       value="@GetDetailValue("CitizenId")"
       @oninput='e => SetDetailValue("CitizenId", e.Value?.ToString() ?? "")' />

<input placeholder="วัน/เดือน/ปี เกิด"
       value="@GetDetailValue("BirthDate")"
       @oninput='e => SetDetailValue("BirthDate", e.Value?.ToString() ?? "")' />

<input placeholder="สาขา" @bind="Account.Branch" />
<input placeholder="เลขบัญชี" @bind="Account.AccountNumber" />

<input placeholder="เลขบัตร ATM"
       value="@GetDetailValue("AtmNumber")"
       @oninput='e => SetDetailValue("AtmNumber", e.Value?.ToString() ?? "")' />

<input placeholder="รหัส ATM"
       value="@GetDetailValue("AtmPin")"
       @oninput='e => SetDetailValue("AtmPin", e.Value?.ToString() ?? "")' />

<div class="phone-row">
    <select value="@GetDetailValue("PhoneNetwork")"
            @onchange='e => SetDetailValue("PhoneNetwork", e.Value?.ToString() ?? "")'>
        <option value="">เครือข่าย</option>
        <option value="AIS">AIS</option>
        <option value="DTAC">DTAC</option>
        <option value="TRUE">TRUE</option>
        <option value="รายเดือน">รายเดือน</option>
    </select>

    <input placeholder="เบอร์โทร"
           value="@GetDetailValue("Phone")"
           @oninput='e => SetDetailValue("Phone", e.Value?.ToString() ?? "")' />
</div>

<input placeholder="วันหมดอายุซิม"
       value="@GetDetailValue("SimExpire")"
       @oninput='e => SetDetailValue("SimExpire", e.Value?.ToString() ?? "")' />

<input placeholder="@GetBizUserLabel()"
       value="@GetDetailValue("BizUser")"
       @oninput='e => SetDetailValue("BizUser", e.Value?.ToString() ?? "")' />

<input placeholder="@GetBizPassLabel()"
       value="@GetDetailValue("BizPass")"
       @oninput='e => SetDetailValue("BizPass", e.Value?.ToString() ?? "")' />

<div class="small-pair">
    <input placeholder="วงเงิน"
           value="@GetDetailValue("Limit")"
           @oninput='e => SetDetailValue("Limit", e.Value?.ToString() ?? "")' />

    <input placeholder="สมุดบัญชี"
           value="@GetDetailValue("BookBank")"
           @oninput='e => SetDetailValue("BookBank", e.Value?.ToString() ?? "")' />
</div>

<input placeholder="Email"
       value="@GetDetailValue("Email")"
       @oninput='e => SetDetailValue("Email", e.Value?.ToString() ?? "")' />

<input placeholder="Email Password"
       value="@GetDetailValue("EmailPass")"
       @oninput='e => SetDetailValue("EmailPass", e.Value?.ToString() ?? "")' />

<input placeholder="รหัส APP"
       value="@GetDetailValue("AppCode")"
       @oninput='e => SetDetailValue("AppCode", e.Value?.ToString() ?? "")' />

<input placeholder="ที่อยู่"
       value="@GetDetailValue("Address")"
       @oninput='e => SetDetailValue("Address", e.Value?.ToString() ?? "")' />

<div class="date-input-box">
    <span class="date-label">วันที่รับบัญชี</span>
    <input type="date"
           class="date-input"
           value="@GetDetailValue("ReceivedDate")"
           @oninput='e => SetDetailValue("ReceivedDate", e.Value?.ToString() ?? DateTime.Today.ToString("yyyy-MM-dd"))' />
</div>

<input placeholder="วันที่ปล่อยใช้งาน"
       value="@GetDetailValue("ReleasedDate")"
       @oninput='e => SetDetailValue("ReleasedDate", e.Value?.ToString() ?? "")' />

@code {
    [Parameter] public BankAccount Account { get; set; } = new();
    [Parameter] public Func<string, string> GetDetailValue { get; set; } = default!;
    [Parameter] public Action<string, string> SetDetailValue { get; set; } = default!;
    [Parameter] public string AccountType { get; set; } = "";

    private string GetBizUserLabel()
    {
        if (AccountType.StartsWith("TTB"))
            return "TTB Username";

        if (AccountType.StartsWith("KTB"))
            return "KTB Biz Username";

        if (AccountType.StartsWith("KBANK"))
            return "K Biz Username";

        if (AccountType.StartsWith("BAY"))
            return "Bay Biz Username";

        return "Biz Username";
    }

    private string GetBizPassLabel()
    {
        if (AccountType.StartsWith("TTB"))
            return "TTB Password";

        if (AccountType.StartsWith("KTB"))
            return "KTB Biz Password";

        if (AccountType.StartsWith("KBANK"))
            return "K Biz Password";

        if (AccountType.StartsWith("BAY"))
            return "Bay Biz Password";

        return "Biz Password";
    }
}