@layout EmptyLayout
@page "/"
@using DataVipWeb.Models
@using DataVipWeb.Services
@using Microsoft.AspNetCore.Components.Web


@inject SupabaseService SupabaseService
@inject NavigationManager Nav

<div class="login-page"
     tabindex="0"
     @onkeydown="HandleKeyDown">
    <form @onsubmit="HandleLogin">
        <div class="login-box">

            <h1>DataVIP</h1>

            <p>เข้าสู่ระบบผู้ดูแล</p>

            <input placeholder="ชื่อผู้ใช้"
                   @bind="loginUsername" />

            <input type="password"
                   placeholder="รหัสผ่าน"
                   @bind="loginPassword" />

            @if (!string.IsNullOrWhiteSpace(loginError))
            {
                <div class="login-error">
                    @loginError

                </div>
            }

            <button type="submit"
                    class="login-btn">
                เข้าสู่ระบบ
            </button>

        </div>
    </form>
</div>

@code {
    private string loginUsername = "";
    private string loginPassword = "";
    private string loginError = "";
    private static Dictionary<string, (int Count, DateTime LastTry)> LoginAttempts = new();

   

    private void RegisterFailedLogin(string ip)
    {
        if (LoginAttempts.ContainsKey(ip))
        {
            LoginAttempts[ip] =
            (
                LoginAttempts[ip].Count + 1,
                DateTime.Now
            );
        }
        else
        {
            LoginAttempts[ip] = (1, DateTime.Now);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }

    private async Task HandleLogin()
    {
        loginError = "";

        var ip = "global";

        if (LoginAttempts.ContainsKey(ip))
        {
            var attempt = LoginAttempts[ip];

            if (attempt.Count >= 5 &&
                DateTime.Now - attempt.LastTry < TimeSpan.FromMinutes(10))
            {
                loginError = "ลองใหม่อีกครั้งใน 10 นาที";
                return;
            }

            if (DateTime.Now - attempt.LastTry > TimeSpan.FromMinutes(10))
            {
                LoginAttempts[ip] = (0, DateTime.Now);
            }
        }

        var result = await SupabaseService.Client
            .From<AppUser>()
            .Filter("username",
                Supabase.Postgrest.Constants.Operator.Equals,
                loginUsername.Trim())
            .Filter("is_active",
                Supabase.Postgrest.Constants.Operator.Equals,
                "true")
            .Get();

        var user = result.Models.FirstOrDefault();

        if (user != null)
        {
            bool isValidPassword = false;

            if (user.Password.StartsWith("$2"))
            {
                isValidPassword =
                    BCrypt.Net.BCrypt.Verify(
                        loginPassword.Trim(),
                        user.Password);
            }
            else
            {
                isValidPassword =
                    user.Password == loginPassword.Trim();
            }

            if (isValidPassword)
            {
                LoginAttempts.Remove(ip);

                AuthState.IsLoggedIn = true;
                AuthState.Username = user.Username;
                AuthState.Role = user.Role;
                AuthState.LoginAt = DateTime.Now;

                Nav.NavigateTo("/employees");
            }
            else
            {
                RegisterFailedLogin(ip);
                loginError = "ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง";
            }
        }
        else
        {
            RegisterFailedLogin(ip);
            loginError = "ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง";
        }
    }
}

<style>
    .login-page {
        min-height: 100vh;
        background: radial-gradient(circle at top left, rgba(124,58,237,.22), transparent 32%), radial-gradient(circle at bottom right, rgba(59,130,246,.20), transparent 32%), #09001f;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-box {
        width: 360px;
        background: rgba(255,255,255,.92);
        backdrop-filter: blur(18px);
        border-radius: 26px;
        padding: 32px;
        box-shadow: 0 30px 70px rgba(0,0,0,.25);
        text-align: center;
    }

        .login-box h1 {
            margin: 0;
            font-size: 40px;
            color: #6d28ff;
            font-weight: 900;
        }

        .login-box p {
            color: #6b7280;
            margin-top: 10px;
            margin-bottom: 24px;
        }

        .login-box input {
            width: 100%;
            box-sizing: border-box;
            margin-bottom: 14px;
            padding: 14px 16px;
            border-radius: 14px;
            border: 1px solid #e5e7eb;
            outline: none;
            font-weight: 600;
            transition: .25s;
        }

            .login-box input:focus {
                border-color: #7c3aed;
                box-shadow: 0 0 0 4px rgba(124,58,237,.12);
            }

    .login-btn {
        width: 100%;
        border: none;
        background: linear-gradient(90deg,#6d28ff,#9333ea);
        color: white;
        padding: 14px;
        border-radius: 14px;
        font-weight: 800;
        cursor: pointer;
        transition: .25s;
    }

        .login-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(124,58,237,.35);
        }

    .login-error {
        color: #dc2626;
        font-weight: 700;
        margin-bottom: 12px;
    }
</style>