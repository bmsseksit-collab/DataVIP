@page "/employees"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using DataVipWeb.Models
@using DataVipWeb.Services
@using Supabase.Storage

@inject SupabaseService SupabaseService

@inject NavigationManager Nav



@code {
    private bool showSuccessToast = false;
    private bool showAddModal = false;
    private string searchText = "";
    private bool showDeleteModal = false;
    private Employee? employeeToDelete;
    private bool showEditModal = false;
    private Employee? editingEmployee;
    private Employee editEmployee = new();
    private bool showEditToast = false;
    private bool showDetailModal = false;
    private Employee? selectedEmployee;
    private string jsonPath = "employees.json";
    private bool showWarningToast = false;
    private string warningMessage = "";
    private string currentTime =
    DateTime.Now.ToString("HH:mm:ss");
    private System.Timers.Timer? clockTimer;
    private bool isSaving = false;
    private bool isLoading = true;
    private bool isDeleting = false;
    private bool isEditing = false;

    

    private DateTime NormalizeThaiYear(DateTime date)
    {
        if (date.Year > 2400)
        {
            return date.AddYears(-543);
        }

        return date;
    }
    private async Task HandleAddModalKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SaveEmployee();
        }

        if (e.Key == "Escape")
        {
            CloseAddModal();
        }
    }

   

    private void ShowWarning()
    {
        showWarningToast = true;

        _ = Task.Run(async () =>
        {
            await Task.Delay(2500);
            showWarningToast = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsLoggedIn)
        {
            Nav.NavigateTo("/");
            return;
        }
        clockTimer = new System.Timers.Timer(1000);

        clockTimer.Elapsed += async (_, _) =>
        {
            currentTime = DateTime.Now.ToString("HH:mm:ss");

            await InvokeAsync(StateHasChanged);
        };

        clockTimer.Start();
        await LoadData();

    }

    private async Task LoadData()
    {
        isLoading = true;

        var result = await SupabaseService.Client
            .From<Employee>()
            .Get();

        employees = result.Models;

        isLoading = false;
    }

    private Task SaveData()
    {
        return Task.CompletedTask;
    }

    private async Task UploadEmployeeImage(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;

            if (file == null || selectedEmployee == null)
                return;

            var fileName =
                $"{Guid.NewGuid()}{Path.GetExtension(file.Name)}";

            using var stream = file.OpenReadStream(1024 * 1024 * 10);

            using var memoryStream = new MemoryStream();

            await stream.CopyToAsync(memoryStream);

            var bytes = memoryStream.ToArray();


            await SupabaseService.Client.Storage
                .From("employees")
                .Upload(
                    bytes,
                    fileName,
                    new Supabase.Storage.FileOptions
                    {
                        Upsert = true
                    });

            var imageUrl = SupabaseService.Client.Storage
                .From("employees")
                .GetPublicUrl(fileName);

            selectedEmployee.ImageUrl = imageUrl;

            await SupabaseService.Client
                .From<Employee>()
                .Update(selectedEmployee);

            await LoadData();

            showSuccessToast = true;

            _ = Task.Run(async () =>
            {
                await Task.Delay(2500);

                showSuccessToast = false;

                await InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            warningMessage = "❌ " + ex.Message;
            showWarningToast = true;
        }
    }


    private void OpenDetailModal(Employee emp)
    {
        selectedEmployee = emp;
        showDetailModal = true;
    }

    private void CloseDetailModal()
    {
        selectedEmployee = null;
        showDetailModal = false;
    }


    private void OpenEditModal(Employee emp)
    {
        editingEmployee = emp;

        editEmployee = new Employee
        {
            Id = emp.Id,
            Code = emp.Code,
            FullName = emp.FullName,
            NickName = emp.NickName,
            StartDate = emp.StartDate,
            Phone = emp.Phone,
            ImageUrl = emp.ImageUrl
        };

        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editingEmployee = null;
        editEmployee = new Employee();
    }

    private async Task SaveEditEmployee()
    {
        if (isEditing)
            return;

        if (editingEmployee == null)
            return;

        isEditing = true;

        try
        {
            editingEmployee.Code = editEmployee.Code.Trim();
            editingEmployee.FullName = editEmployee.FullName.Trim();
            editingEmployee.NickName = editEmployee.NickName.Trim();
            editingEmployee.StartDate =
                NormalizeThaiYear(editEmployee.StartDate);

            editingEmployee.Phone = editEmployee.Phone.Trim();
            editingEmployee.ImageUrl = editEmployee.ImageUrl;

            await SupabaseService.Client
                .From<Employee>()
                .Update(editingEmployee);

            await LoadData();

            CloseEditModal();

            showEditToast = true;

            _ = Task.Run(async () =>
            {
                await Task.Delay(2500);

                showEditToast = false;

                await InvokeAsync(StateHasChanged);
            });
        }
        finally
        {
            isEditing = false;
        }
    }

    private void ConfirmDelete(Employee emp)
    {
        employeeToDelete = emp;

        showDeleteModal = true;
    }

    private async Task DeleteConfirmed()
    {
        if (isDeleting)
            return;

        if (employeeToDelete == null)
            return;

        isDeleting = true;

        try
        {
            if (!string.IsNullOrEmpty(employeeToDelete.ImageUrl))
            {
                var fileName = employeeToDelete.ImageUrl
                    .Split('/')
                    .Last();

                await SupabaseService.Client.Storage
                    .From("employees")
                    .Remove(new List<string> { fileName });
            }

            await SupabaseService.Client
                .From<Employee>()
                .Delete(employeeToDelete);

            await LoadData();

            showDeleteModal = false;
            employeeToDelete = null;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void CancelDelete()
    {
        employeeToDelete = null;

        showDeleteModal = false;
    }

    
    private async Task SaveEmployee()
    {
        if (isSaving)
            return;

        isSaving = true;

        try
        {
            if (string.IsNullOrWhiteSpace(newEmployee.Code) ||
                string.IsNullOrWhiteSpace(newEmployee.FullName) ||
                string.IsNullOrWhiteSpace(newEmployee.NickName) ||
                string.IsNullOrWhiteSpace(newEmployee.Phone))
            {
                warningMessage = "⚠ กรุณากรอกข้อมูลให้ครบ";
                ShowWarning();
                return;
            }

            if (employees.Any(e =>
                e.Code.Equals(newEmployee.Code, StringComparison.OrdinalIgnoreCase)))
            {
                warningMessage = "❌ รหัสพนักงานนี้มีอยู่แล้ว";
                ShowWarning();
                return;
            }

            var employee = new Employee
            {
                Code = newEmployee.Code.Trim(),
                FullName = newEmployee.FullName.Trim(),
                NickName = newEmployee.NickName.Trim(),
                StartDate = NormalizeThaiYear(newEmployee.StartDate),
                Phone = newEmployee.Phone.Trim()
            };

            await SupabaseService.Client
                .From<Employee>()
                .Insert(employee);

            await LoadData();

            newEmployee = new Employee
            {
                StartDate = DateTime.Today
            };

            showAddModal = false;
            showSuccessToast = true;

            _ = Task.Run(async () =>
            {
                await Task.Delay(2500);
                showSuccessToast = false;
                await InvokeAsync(StateHasChanged);
            });
        }
        finally
        {
            isSaving = false;
        }
    }

    private List<Employee> employees = new();

    private Employee newEmployee = new Employee
    {
        StartDate = DateTime.Today
    };

    private string FormatThaiDate(DateTime date)
    {
        string[] thaiMonths =
        {
        "ม.ค.", "ก.พ.", "มี.ค.", "เม.ย.",
        "พ.ค.", "มิ.ย.", "ก.ค.", "ส.ค.",
        "ก.ย.", "ต.ค.", "พ.ย.", "ธ.ค."
    };

        return $"{date.Day:00} {thaiMonths[date.Month - 1]} {date.Year + 543}";
    }
    private string CalculateWorkAge(DateTime startDate)
    {
        var today = DateTime.Today;

        int years = today.Year - startDate.Year;
        int months = today.Month - startDate.Month;

        if (today.Day < startDate.Day)
            months--;

        if (months < 0)
        {
            years--;
            months += 12;
        }

        if (years <= 0)
            return $"{months} เดือน";

        if (months <= 0)
            return $"{years} ปี";

        return $"{years} ปี {months} เดือน";
    }

    private void OpenAddModal()
    {
        showAddModal = true;
    }

    private void CloseAddModal()
    {
        newEmployee = new Employee
        {
            StartDate = DateTime.Today
        };

        showAddModal = false;
    }
}

<div class="employees-page">

    <div>

        <h1 class="page-title">
            รายชื่อพนักงาน
        </h1>

        <p class="page-subtitle">
            ระบบจัดการข้อมูลพนักงาน
        </p>
        <div class="live-clock">
            🕒 @currentTime
        </div>

    </div>

    <div class="cards">

        <div class="card purple-card">
            <h3>พนักงานทั้งหมด</h3>
            <h1 class="card-number">@employees.Count</h1>
        </div>

        <div class="card blue-card">
            <h3>อายุงานเกิน 1 ปี</h3>
            <h1 class="card-number">
                @employees.Count(e => (DateTime.Today - e.StartDate).Days >= 365)
            </h1>
        </div>

        <div class="card orange-card">
            <h3>เข้าใหม่เดือนนี้</h3>
            <h1 class="card-number">
                @employees.Count(e =>
                    e.StartDate.Month == DateTime.Today.Month &&
                    e.StartDate.Year == DateTime.Today.Year)
            </h1>
        </div>

        <div class="card green-card">
            <h3>ผลการค้นหา</h3>
            <h1 class="card-number">
                @employees.Count(e =>
                    string.IsNullOrWhiteSpace(searchText) ||
                    e.Code.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    e.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    e.NickName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    e.Phone.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            </h1>
        </div>

    </div>

    <div class="table-box">

        <div class="table-header">

            <div>
                <h2>รายชื่อพนักงาน</h2>
                <p class="table-subtitle">
                    พบข้อมูล
                    @employees.Count(e =>
                        string.IsNullOrWhiteSpace(searchText) ||
                        e.Code.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                        e.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                        e.NickName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                        e.Phone.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                    รายการ
                </p>
            </div>

            <div class="header-actions">

                <input class="search-box"
                       placeholder="ค้นหาพนักงาน..."
                       @bind="searchText"
                       @bind:event="oninput" />

                <button class="add-btn" @onclick="OpenAddModal">
                    + เพิ่มพนักงาน
                </button>

            </div>

        </div>

        <div class="table-scroll">
            <table>

                
                <thead>
                    <tr>
                        <th>รหัส</th>
                        <th>ชื่อพนักงาน</th>
                        <th>ชื่อเล่น</th>
                        <th>เริ่มทำงานวันที่</th>
                        <th>อายุงาน</th>
                        <th>เบอร์โทร</th>
                        <th>รายละเอียด</th>
                        <th>จัดการ</th>
                        <th>ลบ</th>
                    </tr>
                </thead>

                <tbody>

                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="9">
                                <div class="loading-box">
                                    กำลังโหลดข้อมูล...
                                </div>
                            </td>
                        </tr>
                    }
                    else if (employees.Any())
                    {
                        @foreach (var emp in employees.Where(e =>
                            string.IsNullOrWhiteSpace(searchText) ||
                            e.Code.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                            e.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                            e.NickName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                            e.Phone.Contains(searchText, StringComparison.OrdinalIgnoreCase)))
                        {
                            <tr>
                                <td>@emp.Code</td>
                                <td>@emp.FullName</td>
                                <td>@emp.NickName</td>
                                <td>@FormatThaiDate(emp.StartDate)</td>
                                <td>@CalculateWorkAge(emp.StartDate)</td>
                                <td>@emp.Phone</td>

                                <td>
                                    <button class="detail-btn"
                                            @onclick="() => OpenDetailModal(emp)">
                                        ดูข้อมูล
                                    </button>
                                </td>

                                <td>
                                    <button class="edit-btn"
                                            @onclick="() => OpenEditModal(emp)">
                                        แก้ไข
                                    </button>
                                </td>

                                <td>
                                    <button class="delete-btn"
                                            @onclick="() => ConfirmDelete(emp)">
                                        ลบ
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9">
                                <div class="empty-state">
                                    📂 ยังไม่มีข้อมูลพนักงาน
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>

                

            </table>
        </div>
        <div class="footer-note">
            © @DateTime.Now.Year DataVIP System
        </div>
    </div>

</div>
@if (showAddModal)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <div class="modal-header">
                <h2>เพิ่มพนักงาน</h2>
                <button class="modal-close" @onclick="CloseAddModal">×</button>
            </div>

            <div class="modal-grid">

                <input placeholder="รหัสพนักงาน"
                       @bind="newEmployee.Code"
                       @onkeydown="HandleAddModalKey" />

                <input placeholder="ชื่อพนักงาน"
                       @bind="newEmployee.FullName"
                       @onkeydown="HandleAddModalKey" />

                <input placeholder="ชื่อเล่น"
                       @bind="newEmployee.NickName"
                       @onkeydown="HandleAddModalKey" />

                <input type="date"
                       @bind="newEmployee.StartDate"
                       @onkeydown="HandleAddModalKey" />

                <input placeholder="เบอร์โทร"
                       @bind="newEmployee.Phone"
                       @onkeydown="HandleAddModalKey" />

            </div>

            <div class="modal-actions">
                <button class="cancel-btn" @onclick="CloseAddModal">ยกเลิก</button>
                <button class="save-btn"
                        disabled="@isSaving"
                        @onclick="SaveEmployee">
                    @(isSaving ? "กำลังบันทึก..." : "บันทึก")
                </button>
            </div>
        </div>
    </div>
}
@if (showDeleteModal)
{
    <div class="modal-overlay">

        <div class="delete-modal">

            <h2>ยืนยันการลบ</h2>

            <p>
                ต้องการลบพนักงานนี้ใช่หรือไม่?
            </p>

            <div class="delete-actions">

                <button class="cancel-btn"
                        @onclick="CancelDelete">
                    ยกเลิก
                </button>

                <button class="confirm-delete-btn"
                        disabled="@isDeleting"
                        @onclick="DeleteConfirmed">

                    @(isDeleting ? "กำลังลบ..." : "ลบข้อมูล")

                </button>

            </div>

        </div>

    </div>
}
@if (showSuccessToast)
{
    <div class="success-toast">
        ✔ บันทึกข้อมูลพนักงานสำเร็จ
    </div>
}
@if (showEditModal)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <div class="modal-header">
                <h2>แก้ไขพนักงาน</h2>
                <button class="modal-close" @onclick="CloseEditModal">×</button>
            </div>

            <div class="modal-grid">
                <input placeholder="รหัสพนักงาน" @bind="editEmployee.Code" />
                <input placeholder="ชื่อพนักงาน" @bind="editEmployee.FullName" />
                <input placeholder="ชื่อเล่น" @bind="editEmployee.NickName" />
                <input type="date" @bind="editEmployee.StartDate" />
                <input placeholder="เบอร์โทร" @bind="editEmployee.Phone" />
            </div>

            <div class="modal-actions">
                <button class="cancel-btn" @onclick="CloseEditModal">ยกเลิก</button>
                <button class="save-btn"
                        disabled="@isEditing"
                        @onclick="SaveEditEmployee">

                    @(isEditing ? "กำลังบันทึก..." : "บันทึก")

                </button>
            </div>
        </div>
    </div>
}
@if (showEditToast)
{
    <div class="edit-toast">
        ✏ แก้ไขข้อมูลพนักงานสำเร็จ
    </div>
}
@if (showDetailModal && selectedEmployee != null)
{
    <div class="modal-overlay">
        <div class="detail-modal">
            <div class="profile-upload">

                @if (!string.IsNullOrEmpty(selectedEmployee.ImageUrl))
                {
                    <img src="@selectedEmployee.ImageUrl" class="profile-image" />
                }
                else
                {
                    <div class="profile-placeholder">👤</div>
                }

                <label class="upload-label">
                    📷 เลือกรูป
                    <InputFile OnChange="UploadEmployeeImage" class="hidden-file" />
                </label>

            </div>
            <div class="modal-header">
                <h2>รายละเอียดพนักงาน</h2>
                <button class="modal-close" @onclick="CloseDetailModal">×</button>
            </div>

            <div class="detail-list">
                <p><b>รหัส:</b> @selectedEmployee.Code</p>
                <p><b>ชื่อพนักงาน:</b> @selectedEmployee.FullName</p>
                <p><b>ชื่อเล่น:</b> @selectedEmployee.NickName</p>
                <p><b>วันที่เริ่มงาน:</b> @FormatThaiDate(selectedEmployee.StartDate)</p>
                <p><b>อายุงาน:</b> @CalculateWorkAge(selectedEmployee.StartDate)</p>
                <p><b>เบอร์โทร:</b> @selectedEmployee.Phone</p>
            </div>
        </div>
    </div>
}
@if (showWarningToast)
{
    <div class="warning-toast">
        @warningMessage
    </div>
}


<style>
    .employees-page {
        animation: pageFade .45s ease;
    }

    html {
        scroll-behavior: smooth;
    }

    ::-webkit-scrollbar {
        width: 10px;
        height: 10px;
    }

    ::-webkit-scrollbar-track {
        background: #f3f4f6;
    }

    ::-webkit-scrollbar-thumb {
        background: linear-gradient(#7c3aed,#581c87);
        border-radius: 20px;
    }

        ::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(#6d28ff,#4c1d95);
        }

    50% {
        background-position: 0% 100%;
    }

    100% {
        background-position: 0% 0%;
    }

    }

    100% {
        background-position: 200% center;
    }

    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pageFade {

        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .page-title {
        margin: 0;
        font-size: 34px;
        font-weight: 800;
        color: #1e1b4b;
    }

    .page-subtitle {
        margin: 4px 0 0;
        color: #8b8b9f;
        font-size: 14px;
    }

    .cards {
        margin: 20px 0 24px;
    }

    .card {
        width: 220px;
        height: 110px;
        background: white;
        padding: 18px 22px;
        border-radius: 20px;
        border: 1px solid #f1ebff;
        box-shadow: 0 10px 30px rgba(0,0,0,.05);
        position: relative;
        overflow: hidden;
        transition: .25s;
    }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 30px rgba(124,58,237,.15);
        }

        .card::before {
            content: "";
            position: absolute;
            right: -35px;
            top: -35px;
            width: 110px;
            height: 110px;
            background: rgba(124,58,237,.08);
            border-radius: 50%;
        }

        .card::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient( 120deg, transparent, rgba(255,255,255,.10), transparent );
            transform: translateX(-100%);
            transition: .7s;
        }

        .card:hover::after {
            transform: translateX(100%);
        }

        .card h3 {
            margin: 0;
            font-size: 18px;
        }

    .card-number {
        margin: 8px 0 0;
        font-size: 42px;
        font-weight: 900;
        color: #1e1b4b;
    }

    .table-box {
        width: 100%;
        background: rgba(255,255,255,.72);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(255,255,255,.35);
        padding: 24px;
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(0,0,0,.04);
        box-sizing: border-box;
    }

    .table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

        .table-header h2 {
            margin: 0;
            font-size: 28px;
            color: #1e1b4b;
        }

    .table-subtitle {
        margin: 5px 0 0;
        color: #9ca3af;
        font-size: 14px;
    }

    .header-actions {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .search-box {
        width: 250px;
        padding: 13px 16px;
        border-radius: 14px;
        border: 1px solid #ece0ff;
        outline: none;
        transition: .25s;
        background: rgba(255,255,255,.7);
        backdrop-filter: blur(10px);
        font-size: 14px;
        font-weight: 600;
        color: #4b5563;
        box-shadow: 0 6px 18px rgba(124,58,237,.08);
    }

        .search-box:focus {
            border-color: #7c3aed;
            background: white;
            box-shadow: 0 0 0 5px rgba(124,58,237,.12), 0 12px 25px rgba(124,58,237,.18);
            transform: translateY(-1px);
        }

    .add-btn {
        border: none;
        background: linear-gradient(90deg,#6d28ff,#a855f7);
        color: white;
        padding: 12px 20px;
        border-radius: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: .25s;
        position: relative;
        overflow: hidden;
    }

        .add-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(124,58,237,.35);
        }

    table {
        width: 100%;
